# Copy to backend/.env for local use. Never commit the filled file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1/
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
# Generate a persistent random value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
DATABASE_PATH=backend/var/stage0.sqlite
ALLOWED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321,http://127.0.0.1:8787,http://localhost:8787
SERVE_STATIC=false
# Attempts include both chat replies and assessment answers, including failed calls.
USER_DAILY_CALLS=30
USER_DAILY_TOKENS=150000
IP_DAILY_CALLS=100
GLOBAL_DAILY_CALLS=500
GLOBAL_DAILY_TOKENS=2000000
SIGNUP_DAILY_LIMIT=3
AUTH_HOURLY_LIMIT=20
MAX_OUTPUT_TOKENS=1000
AI_TIMEOUT_MS=45000
# Leave 0 unless ingress is restricted to your trusted reverse proxy.
TRUST_PROXY_HOPS=0

---
import Base from '../layouts/Base.astro';
import ThemeCard from '../components/ThemeCard.astro';
import { themes, clusters, totalQuestions, syllabus, u, themeUrl, telegramBot, roadmap, stages, shortTitle } from '../lib/data';
import { daily, prelims, preYears } from '../lib/daily';
const cross = themes.filter((t) => t.cross).length;
const top = [...themes].sort((a, b) => b.count - a.count || b.recent - a.recent || a.n - b.n).slice(0, 6);
const desc = `Prepare UPSC by theme, not by paper. ${totalQuestions} GS Mains PYQs in ${themes.length} cross-paper themes, a beginner roadmap, map practice, and 10 Prelims + 2 Mains PYQs every day.`;
const ld = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'UPSC Themes', alternateName: 'Theme-wise UPSC Mains PYQs', url: new URL(u('/'), Astro.site).href,
  description: desc, inLanguage: 'en-IN',
  potentialAction: { '@type': 'SearchAction', target: new URL(u('/search/'), Astro.site).href + '?q={query}', 'query-input': 'required name=query' } }];
const rm = roadmap.map((t) => ({ n: t.n, step: t.step, title: shortTitle(t), url: themeUrl(t) }));
const preCount = prelims.filter((q) => q.year).length;
---
<Base title="UPSC Themes: theme-wise UPSC PYQs, roadmap and daily practice" description={desc} jsonld={ld} brand={false}>
  <h1 class="home-h1">Prepare UPSC by theme, one day at a time</h1>
  <section class="about" aria-labelledby="about-h">
    <h2 id="about-h">What this site is</h2>
    <p>A free study companion for UPSC Civil Services aspirants, beginners and repeaters alike. It takes every GS Mains question asked since 2013 ({totalQuestions} of them) and groups them into {themes.length} themes, because the syllabus is interlinked: women's empowerment, for example, comes up in GS1, GS2 and GS3. No sign-up, no fees.</p>
    <ol class="how">
      <li><b>Practise every day</b><span>10 Prelims and 2 Mains PYQs each morning, on the site or on Telegram.</span></li>
      <li><b>Follow the roadmap</b><span>Study the themes in an order where each one builds on the last.</span></li>
      <li><b>Write better answers</b><span>Each theme shows what UPSC keeps asking, what to cover and how to structure the answer.</span></li>
    </ol>
    <p class="small"><a href={u('/about/')}>Sources and how the themes were made</a></p>
  </section>

  <section class="today" aria-labelledby="today-h">
    <div class="today-main">
      <h2 id="today-h">Today's practice</h2>
      <p>10 Prelims questions with UPSC marking, then 2 Mains answers to write against the clock.</p>
      <div class="sheet" aria-hidden="true" id="sheet">
        {Array.from({ length: 10 }, (_, i) => <span class="b"><i>{i + 1}</i></span>)}
      </div>
      <p class="today-status" id="today-status">Not started yet</p>
      <div class="today-cta">
        <a class="btn onblue" href={u('/daily/')} id="today-go" data-umami-event="home-cta" data-umami-event-target="daily">Start today's set</a>
        <a class="btn ghost" href={telegramBot} target="_blank" rel="noopener" data-umami-event="telegram-subscribe" data-umami-event-where="home">Get it on Telegram</a>
      </div>
    </div>
  </section>

  <section class="cont panel" aria-labelledby="cont-h">
    <div>
      <h2 id="cont-h">Continue the roadmap</h2>
      <p class="small" id="cont-sub">Step 1 of {roadmap.length}. Each theme builds on the ones before it.</p>
      <p class="cont-title"><a id="cont-link" href={rm[0].url} data-umami-event="home-cta" data-umami-event-target="roadmap-continue">{rm[0].title}</a></p>
    </div>
    <div class="cont-bar" aria-hidden="true"><span id="cont-fill"></span></div>
    <p class="cont-more"><a href={u('/roadmap/')}>See all {stages.length} stages</a></p>
  </section>

  <h2>Practise and browse</h2>
  <ul class="tiles">
    <li><a href={u('/prelims/')}><b>Prelims PYQs</b><span>{preCount} questions with answer key, by year or subject</span></a></li>
    <li><a href={u('/papers/gs1/')}><b>Mains by paper</b><span>GS1, GS2 and GS3, year by year</span></a></li>
    <li><a href={u('/maps/')}><b>Map practice</b><span>16 map modules and a sketch lab with real PYQs</span></a></li>
    <li><a href={u('/sources/')}><b>Good reads</b><span>Official sites worth reading, by subject</span></a></li>
    <li><a href={u('/syllabus/')}><b>From the syllabus</b><span>All {syllabus.length} syllabus lines and their themes</span></a></li>
  </ul>

  <h2>Most-asked themes</h2>
  <ul class="tlist">{top.map((t) => <ThemeCard t={t} />)}</ul>
  <p><a class="btn" href={u('/themes/')}>All {themes.length} themes</a></p>

  <h2>Themes by area</h2>
  <div class="areas">
    {clusters.map((c) => {
      const ts = themes.filter((t) => t.cluster === c.name);
      return <details class="area">
        <summary><span class="an">{c.name}<span class="small">{ts.length} themes, {ts.reduce((s, t) => s + t.count, 0)} PYQs</span></span></summary>
        <div class="chips">{ts.map((t) => <a class="chip" href={themeUrl(t)}>{t.title}</a>)}</div>
        <p><a href={u(`/topics/${c.slug}/`)}>Open {c.name}</a></p>
      </details>;
    })}
  </div>

  <div class="facts">
    <div><b>{totalQuestions}</b><span>Mains PYQs, 2013–2026</span></div>
    <div><b>{themes.length}</b><span>themes, {cross} of them cross-paper</span></div>
    <div><b>{preCount}</b><span>Prelims PYQs, {preYears.at(-1)}–{preYears[0]}</span></div>
  </div>

  <script is:inline define:vars={{ rm, epoch: daily.epoch }}>
    (function () {
      var store = {}, done = [];
      try { store = JSON.parse(localStorage.getItem('upscthemes-daily') || '{}'); } catch (e) {}
      try { done = JSON.parse(localStorage.getItem('upscthemes-done') || '[]'); } catch (e) {}
      var today = new Date(Date.now() + 5.5 * 36e5).toISOString().slice(0, 10), t = store[today] || {};
      var picks = (t.p || []).filter(Boolean).length;
      [].forEach.call(document.querySelectorAll('#sheet .b'), function (b, i) { if (t.p && t.p[i]) b.classList.add('on'); });
      var st = document.getElementById('today-status'), go = document.getElementById('today-go');
      if (t.checked) { st.textContent = 'Done for today. Come back tomorrow for a new set.'; go.textContent = 'Review today’s answers'; }
      else if (picks) { st.textContent = picks + ' of 10 answered'; go.textContent = 'Continue today’s set'; }
      var next = rm.find(function (x) { return done.indexOf(x.n) < 0; });
      if (done.length && next) {
        document.getElementById('cont-sub').textContent = 'Step ' + next.step + ' of ' + rm.length + ' · ' + done.length + ' done';
        var a = document.getElementById('cont-link'); a.textContent = next.title; a.href = next.url;
      }
      document.getElementById('cont-fill').style.width = Math.round(100 * done.length / rm.length) + '%';
    })();
  </script>
  <style>
    .home-h1 { margin-top: 8px; }
    .about { margin: 18px 0 8px; }
    .about h2 { margin: 0 0 6px; font-size: 1.2rem; }
    .about > p { margin: 0 0 14px; max-width: 70ch; }
    .how { list-style: none; counter-reset: how; padding: 0; margin: 0 0 10px; display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    .how li { counter-increment: how; display: grid; align-content: start; gap: 2px; padding: 14px 16px 14px 56px; position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); }
    .how li::before { content: counter(how); position: absolute; left: 14px; top: 14px; width: 30px; height: 30px; border-radius: 50%; border: 2px solid var(--omr); color: var(--omr); display: grid; place-items: center; font-weight: 800; font-size: .9rem; }
    .how b { font-size: 1rem; } .how span { color: var(--muted); font-size: .92rem; line-height: 1.45; }
    .about .small { margin: 0; font-weight: 600; }
    .today { background: var(--accent); color: #fff; border-radius: var(--r-lg); padding: 22px 22px 20px; margin: 22px 0 14px; position: relative; overflow: hidden; }
    .today h2 { margin: 0 0 4px; color: #fff; font-size: 1.5rem; }
    .today p { margin: 0; color: rgba(255, 255, 255, .88); max-width: 52ch; }
    .sheet { display: grid; grid-template-columns: repeat(10, minmax(0, 34px)); gap: 8px; margin: 18px 0 8px; }
    .sheet .b { aspect-ratio: 1; border-radius: 50%; border: 2px solid rgba(255, 255, 255, .55); display: grid; place-items: center; }
    .sheet .b i { font-style: normal; font-size: .72rem; font-weight: 700; color: rgba(255, 255, 255, .75); }
    .sheet .b.on { background: #fff; border-color: #fff; } .sheet .b.on i { color: var(--accent); }
    .today-status { font-weight: 600; font-size: .92rem; }
    .today-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
    .btn.onblue { background: #fff; border-color: #fff; color: #2340b5; } .btn.onblue:hover { color: #2340b5; filter: brightness(.96); }
    .btn.ghost { background: transparent; border-color: rgba(255, 255, 255, .6); color: #fff; } .btn.ghost:hover { border-color: #fff; color: #fff; }
    @media (prefers-color-scheme: dark) { .today { background: #2340b5; } }
    .cont { display: grid; gap: 10px; }
    .cont h2 { margin: 0; font-size: 1.15rem; } .cont .small { margin: 2px 0 0; }
    .cont-title { margin: 6px 0 0; font-size: 1.15rem; font-weight: 700; } .cont-title a { color: var(--ink); }
    .cont-bar { height: 6px; background: var(--bg); border-radius: 99px; overflow: hidden; } .cont-bar span { display: block; height: 100%; width: 0; background: var(--accent); }
    .cont-more { margin: 0; font-weight: 600; }
    .tiles { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
    .tiles a { display: grid; gap: 4px; height: 100%; padding: 16px 18px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); text-decoration: none; color: var(--ink); }
    .tiles a:hover { border-color: var(--accent); }
    .tiles b { font-size: 1.05rem; } .tiles span { color: var(--muted); font-size: .9rem; line-height: 1.4; }
    .areas { display: grid; gap: 8px; }
    .area { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); padding: 0 16px; }
    .area summary { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center; padding: 12px 0; cursor: pointer; font-weight: 700; list-style: none; }
    .an { display: grid; } .an .small { font-weight: 500; font-size: .85rem; }
    .area summary::-webkit-details-marker { display: none; }
    .area summary::after { content: "+"; font-weight: 800; font-size: 1.3rem; color: var(--accent); }
    .area[open] summary::after { content: "−"; }
    .area .chips { padding-bottom: 6px; } .area p { margin: 10px 0 14px; font-weight: 600; }
    .facts { margin-top: 36px; padding-top: 18px; border-top: 1px solid var(--line); }
    @media (max-width: 480px) { .sheet { gap: 5px; } .today { padding: 18px 16px; } }
  </style>
</Base>

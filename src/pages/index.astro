---
import Base from '../layouts/Base.astro';
import HomeLearning from '../components/workspace/HomeLearning.astro';
import ThemeCard from '../components/ThemeCard.astro';
import { themes, clusters, totalQuestions, u, themeUrl, telegramBot, roadmap, stages, shortTitle } from '../lib/data';
import { daily, prelims, preYears } from '../lib/daily';
const cross = themes.filter((t) => t.cross).length;
const top = [...themes].sort((a, b) => b.count - a.count || b.recent - a.recent || a.n - b.n).slice(0, 6);
const desc = `Prepare UPSC by theme, not by paper. ${totalQuestions} GS Mains PYQs in ${themes.length} cross-paper themes, a beginner roadmap, map practice, and 10 Prelims + 2 Mains PYQs every day.`;
const ld = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'UPSC Themes', alternateName: 'Theme-wise UPSC Mains PYQs', url: new URL(u('/'), Astro.site).href,
  description: desc, inLanguage: 'en-IN',
  potentialAction: { '@type': 'SearchAction', target: new URL(u('/search/'), Astro.site).href + '?q={query}', 'query-input': 'required name=query' } }];
const rm = roadmap.map((t) => ({ n: t.n, step: t.step, title: shortTitle(t), url: themeUrl(t) }));
const preCount = prelims.filter((q) => q.year).length;
---
<Base title="UPSC Themes: theme-wise UPSC PYQs, roadmap and daily practice" description={desc} jsonld={ld} brand={false}>
  <header class="home-heading">
    <p class="eyebrow">Your study workspace</p>
    <h1>One idea. A little practice. Every day.</h1>
    <p class="lead">Learn the foundations, connect the syllabus and practise real UPSC questions. Free to explore, at your pace.</p>
    <nav class="home-reference" aria-label="Study references">
      <a href={u('/syllabus/')}>Syllabus <span aria-hidden="true">↗</span></a>
      <a href={u('/sources/')}>Good Reads <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <HomeLearning />
  <div class="practice-row">
    <section class="today" aria-labelledby="today-h">
      <p class="eyebrow">A daily habit</p><h2 id="today-h">Today's practice</h2>
      <p>10 Prelims questions and 2 Mains prompts, with an optional timer.</p>
      <p class="small" id="today-status" role="status">A fresh set every morning.</p>
      <a class="btn" href={u('/daily/')} id="today-go" data-umami-event="home-cta" data-umami-event-target="daily">Start today's set →</a>
      <a class="telegram-link" href={telegramBot} target="_blank" rel="noopener" data-umami-event="telegram-subscribe" data-umami-event-where="home">Get it on Telegram ↗</a>
    </section>
    <section class="cont" aria-labelledby="cont-h">
      <p class="eyebrow">A guided path</p><h2 id="cont-h">Your preparation roadmap</h2>
      <p>Build from one theme to the next, in an order that connects ideas.</p>
      <p class="small" id="cont-sub">Step 1 of {roadmap.length} · {rm[0].title}</p>
      <a class="btn" id="cont-link" href={rm[0].url} data-umami-event="home-cta" data-umami-event-target="roadmap-continue">Start the roadmap →</a>
      <a class="roadmap-link" href={u('/roadmap/')}>All {stages.length} stages ↗</a>
    </section>
  </div>
  <section aria-labelledby="browse-title">
    <div class="section-heading"><h2 id="browse-title">Your study library</h2><a href={u('/search/')}>Search everything ↗</a></div>
    <ul class="library-list">
      <li><a href={u('/syllabus/')}><span><b>Syllabus</b><small>Every syllabus line, linked to its themes and questions</small></span><span aria-hidden="true">↗</span></a></li>
      <li><a href={u('/sources/')}><span><b>Good Reads</b><small>Official sources and useful reading, organised by subject</small></span><span aria-hidden="true">↗</span></a></li>
      <li><a href={u('/prelims/')}><span><b>Prelims questions</b><small>{preCount} questions with answer keys, by year or subject</small></span><span aria-hidden="true">↗</span></a></li>
      <li><a href={u('/papers/gs1/')}><span><b>Mains papers</b><small>GS1, GS2 and GS3, year by year</small></span><span aria-hidden="true">↗</span></a></li>
      <li><a href={u('/maps/')}><span><b>Map practice</b><small>16 modules and a sketch lab with real UPSC questions</small></span><span aria-hidden="true">↗</span></a></li>
    </ul>
  </section>
  <section aria-labelledby="themes-title">
    <div class="section-heading"><h2 id="themes-title">Most-asked themes</h2><a href={u('/themes/')}>All {themes.length} themes ↗</a></div>
    <ul class="tlist">{top.map((t) => <ThemeCard t={t} />)}</ul>
  </section>
  <section aria-labelledby="areas-title">
    <h2 id="areas-title">Browse by subject area</h2>
    <div class="areas">{clusters.map((c) => {
      const ts = themes.filter((t) => t.cluster === c.name);
      return <details class="area"><summary><span>{c.name}<small>{ts.length} themes · {ts.reduce((sum, t) => sum + t.count, 0)} PYQs</small></span></summary><div class="chips">{ts.map((t) => <a class="chip" href={themeUrl(t)}>{t.title}</a>)}</div><p><a href={u(`/topics/${c.slug}/`)}>Open {c.name} →</a></p></details>;
    })}</div>
  </section>
  <p class="home-about">{totalQuestions} Mains questions across {themes.length} themes, including {cross} that connect multiple papers. Prelims questions from {preYears.at(-1)}–{preYears[0]}. <a href={u('/about/')}>About this free study companion</a>.</p>
  <script is:inline define:vars={{ rm }}>
    (function () {
      function read(key, fallback) { try { return JSON.parse(localStorage.getItem(key)) || fallback; } catch (e) { return fallback; } }
      function render(snapshot) {
        var daily = snapshot && snapshot.daily || {}, done = snapshot && Array.isArray(snapshot.roadmap) ? snapshot.roadmap : [];
        done = rm.filter(function (x) { return done.indexOf(x.n) >= 0; }).map(function (x) { return x.n; });
        var today = new Date(Date.now() + 5.5 * 36e5).toISOString().slice(0, 10), t = daily[today] || {};
        var picks = Array.isArray(t.p) ? t.p.filter(Boolean).length : 0;
        var st = document.getElementById('today-status'), go = document.getElementById('today-go');
        st.textContent = 'A fresh set every morning.'; go.textContent = "Start today's set →";
        if (t.checked) { st.textContent = 'Completed today. Your next set arrives tomorrow.'; go.textContent = 'Review today’s answers →'; }
        else if (picks) { st.textContent = picks + ' of 10 answered'; go.textContent = 'Continue today’s set →'; }
        var next = rm.find(function (x) { return done.indexOf(x.n) < 0; }), link = document.getElementById('cont-link');
        link.href = (next || rm[0]).url; link.textContent = done.length ? next ? 'Continue the roadmap →' : 'Revisit the roadmap →' : 'Start the roadmap →';
        document.getElementById('cont-sub').textContent = next ? 'Step ' + next.step + ' of ' + rm.length + ' · ' + next.title : 'All ' + rm.length + ' themes completed. Revisit any theme.';
      }
      function guest() { render({ daily: read('upscthemes-daily', {}), roadmap: read('upscthemes-done', []) }); }
      window.addEventListener('activity-snapshot', function (event) { render(event.detail); });
      window.addEventListener('storage', function () { if (window.__activityScope === 'guest') guest(); });
      if (window.__activitySnapshot) render(window.__activitySnapshot);
      else if (!document.querySelector('[data-activity-status]')) guest();
      else render(null);
    })();
  </script>
  <style>
    .home-heading { padding: 12px 0 0; }
    h1 { font-size: clamp(1.9rem, 3.4vw, 2.6rem); max-width: 24ch; margin: 10px 0 14px; font-weight: 700; }
    .lead { font-size: 1rem; max-width: 62ch; }
    .home-reference { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 14px; }
    .home-reference a { display: inline-flex; gap: 16px; align-items: center; min-height: 44px; font-weight: 600; font-size: .92rem; color: var(--ink); text-decoration: none; }
    .home-reference a:hover { text-decoration: underline; }
    .practice-row { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--line); }
    .practice-row section { padding: 28px 28px 28px 0; min-width: 0; }
    .practice-row section + section { border-left: 1px solid var(--line); padding-left: 28px; padding-right: 0; }
    .practice-row h2 { margin: 5px 0 10px; font-size: 1.25rem; }
    .practice-row p:not(.eyebrow) { color: var(--muted); margin: 10px 0 16px; }
    .practice-row .small { min-height: 2.8em; }
    .telegram-link, .roadmap-link { display: block; font-size: .82rem; margin-top: 12px; min-height: 32px; }
    .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 32px 0 14px; }
    .section-heading h2 { margin: 0; font-size: 1.3rem; }
    .section-heading > a { font-size: .84rem; min-height: 44px; display: inline-flex; align-items: center; text-decoration: none; }
    .library-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
    .library-list a { display: flex; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--line); padding: 16px 4px; color: var(--ink); text-decoration: none; }
    .library-list a:hover { background: var(--hover); }
    .library-list b { font-size: .97rem; font-weight: 600; }
    .library-list small, .area small { display: block; color: var(--muted); font-size: .84rem; margin-top: 3px; }
    .areas { border-top: 1px solid var(--line); }
    .area { padding: 0 4px; border-bottom: 1px solid var(--line); }
    .area summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 0; cursor: pointer; list-style: none; font-weight: 600; }
    .area summary::-webkit-details-marker { display: none; }
    .area summary::after { content: '+'; color: var(--muted); }
    .area[open] summary::after { content: '−'; }
    .area .chips { padding-top: 8px; }
    .home-about { margin-top: 32px; font-size: .85rem; color: var(--muted); max-width: 76ch; }
    @media (max-width: 540px) {
      .practice-row { grid-template-columns: minmax(0, 1fr); }
      .practice-row section { padding: 24px 0; }
      .practice-row section + section { padding: 24px 0; border-left: 0; border-top: 1px solid var(--line); }
      .practice-row .small { min-height: 0; }
      .home-heading { padding-top: 4px; }
    }
  </style>
</Base>

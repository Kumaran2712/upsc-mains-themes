---
import Base from '../../layouts/Base.astro';
import QuestionItem from '../../components/QuestionItem.astro';
import { themes, byN, syllabus, themeUrl, yearSpan, u, clip, paperName, shortTitle, type Theme } from '../../lib/data';
export function getStaticPaths() { return themes.map((t) => ({ params: { slug: t.slug }, props: { t } })); }
const { t } = Astro.props as { t: Theme };
const paperList = Object.entries(t.papers).filter(([, v]) => v).map(([k]) => k);
const title = `${shortTitle(t)} – UPSC Mains PYQs`;
const desc = clip(`${t.count} UPSC GS Mains PYQs (${yearSpan(t)}) on ${t.title.split(':')[0].toLowerCase()}. ${t.asks}`);
const syl = syllabus.filter((s) => t.syllabus.includes(s.id));
const idx = themes.indexOf(t); const prev = themes[idx - 1]; const next = themes[idx + 1];
const ld = [{ '@context': 'https://schema.org', '@type': 'LearningResource', name: t.title, description: desc,
  url: new URL(themeUrl(t), Astro.site).href, inLanguage: 'en-IN', learningResourceType: 'Previous year questions and study guide',
  educationalLevel: 'UPSC Civil Services (Main) Examination', teaches: t.checklist.slice(0, 6),
  about: paperList.map((p) => ({ '@type': 'Thing', name: `${p}: ${paperName[p]}` })),
  isPartOf: { '@type': 'WebSite', name: 'GS Mains Theme Atlas', url: new URL(u('/'), Astro.site).href } }];
---
<Base title={title} description={desc} jsonld={ld} brand={title.length <= 50}
  crumbs={[{ name: t.cluster, href: u(`/topics/${t.clusterSlug}/`) }, { name: `T${t.n}`, href: themeUrl(t) }]}>
  <p class="eyebrow">Theme T{t.n} · {t.cluster}</p>
  <h1>{t.title}</h1>
  <div class="facts">
    <div><b>{t.count}</b><span>PYQs</span></div>
    {paperList.map((p) => <div><b>{t.papers[p]}</b><span>{p}</span></div>)}
    <div><b>{yearSpan(t)}</b><span>{t.years.length} distinct years</span></div>
    {t.recent > 0 && <div><b>{t.recent}</b><span>asked 2024–26</span></div>}
  </div>
  <p><button class="btn" type="button" data-share>Share this theme</button></p>

  <h2>What UPSC asks</h2>
  <p>{t.asks}</p>

  <h2>Prepare these</h2>
  <ul>{t.checklist.map((x) => <li>{x}</li>)}</ul>

  <h2>Answer writing</h2>
  <ul>{t.answer.map((x) => <li>{x}</li>)}</ul>
  {t.directives.length > 0 && <p class="lead">Directive words in these PYQs: {t.directives.map(([d, c]) => `${d} (${c})`).join(', ')}.</p>}

  {t.links.length > 0 && <>
    <h2>Linked themes</h2>
    <p class="lead">Questions here often need understanding from these themes too.</p>
    <div class="chips">{t.links.map((n) => { const l = byN.get(n)!; return <a class="chip" href={themeUrl(l)} data-umami-event="linked-theme-click" data-umami-event-from={`T${t.n}`} data-umami-event-to={`T${n}`}>T{n} {l.title}</a>; })}</div>
  </>}

  <h2>Syllabus lines covered</h2>
  <ul>{syl.map((s) => <li><a href={u(`/syllabus/${s.id.toLowerCase()}/`)}>{s.id}</a> — {s.text}</li>)}</ul>

  <h2>All {t.count} PYQs, newest first</h2>
  <ol class="qs">{t.questions.map((q) => <QuestionItem q={q} />)}</ol>

  <nav class="chips" aria-label="More themes" style="margin-top:28px">
    {prev && <a class="chip" href={themeUrl(prev)}>← T{prev.n} {prev.title.split(':')[0]}</a>}
    {next && <a class="chip" href={themeUrl(next)}>T{next.n} {next.title.split(':')[0]} →</a>}
  </nav>
</Base>

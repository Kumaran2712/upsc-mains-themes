---
import Base from '../../layouts/Base.astro';
import QuestionItem from '../../components/QuestionItem.astro';
import PrelimsItem from '../../components/PrelimsItem.astro';
import { prelims } from '../../lib/daily';
import { mapLinksFor, moduleUrl } from '../../lib/maps';
import { themes, byN, byStep, stages, roadmap, syllabus, themeUrl, yearSpan, u, clip, paperName, shortTitle, type Theme } from '../../lib/data';
export function getStaticPaths() { return themes.map((t) => ({ params: { slug: t.slug }, props: { t } })); }
const { t } = Astro.props as { t: Theme };
const paperList = Object.entries(t.papers).filter(([, v]) => v).map(([k]) => k);
const pById = new Map(prelims.map((q) => [q.id, q]));
const preQs = t.pre.map((id) => pById.get(id)!);
const cv = t.cover;
const title = `${shortTitle(t)} – UPSC ${preQs.length ? 'Prelims & Mains' : 'Mains'} PYQs`;
const countText = [t.count ? `${t.count} GS Mains PYQs (${yearSpan(t)})` : '', preQs.length ? `${preQs.length} Prelims PYQs` : ''].filter(Boolean).join(' and ');
const desc = clip(`${countText || 'Study guide'} on ${t.title.split(':')[0].toLowerCase()}${cv ? ', with NCERT, standard book and Bare Act pointers' : ''}. ${t.asks}`);
const tag = (x: { p: number | null; m: number | null }) => x.p === null ? null : (x.p || x.m) ? [x.p ? `Prelims ${x.p}` : '', x.m ? `Mains ${x.m}` : ''].filter(Boolean).join(' · ') : '';
const syl = syllabus.filter((s) => t.syllabus.includes(s.id));
const prev = byStep.get(t.step - 1); const next = byStep.get(t.step + 1);
const stage = stages[t.stage - 1];
const buildsOn = t.prereqs.map((n) => byN.get(n)!).sort((a, b) => a.step - b.step);
const comesBack = t.related.map((n) => byN.get(n)!).filter((l) => l.step > t.step).sort((a, b) => a.step - b.step);
const linked = [...buildsOn, ...comesBack];
const mapLinks = mapLinksFor(t.key);
const ld = [{ '@context': 'https://schema.org', '@type': 'LearningResource', name: t.title, description: desc,
  url: new URL(themeUrl(t), Astro.site).href, inLanguage: 'en-IN', learningResourceType: 'Previous year questions and study guide',
  educationalLevel: 'UPSC Civil Services (Main) Examination', teaches: t.checklist.slice(0, 6),
  about: paperList.map((p) => ({ '@type': 'Thing', name: `${p}: ${paperName[p]}` })),
  isPartOf: { '@type': 'WebSite', name: 'UPSC Themes', url: new URL(u('/'), Astro.site).href } }];
---
<Base title={title} description={desc} jsonld={ld} brand={title.length <= 50}
  crumbs={[{ name: t.cluster, href: u(`/topics/${t.clusterSlug}/`) }, { name: `T${t.n}`, href: themeUrl(t) }]}>
  <p class="eyebrow">Theme T{t.n} · {t.cluster}</p>
  <h1>{t.title}</h1>
  <div class="facts">
    <div><b>{t.count}</b><span>Mains PYQs</span></div>
    {preQs.length > 0 && <div><b>{preQs.length}</b><span>Prelims PYQs</span></div>}
    {paperList.map((p) => <div><b>{t.papers[p]}</b><span>{p}</span></div>)}
    {t.years.length > 0 && <div><b>{yearSpan(t)}</b><span>{t.years.length} distinct years</span></div>}
    {t.recent > 0 && <div><b>{t.recent}</b><span>asked 2024–26</span></div>}
  </div>
  <div class="panel rmbar">
    <p class="eyebrow">Roadmap · step {t.step} of {roadmap.length} · Stage {stage.n}: {stage.name.split(':')[0]}</p>
    <div class="rmbtns">
      {prev && <a class="btn" href={themeUrl(prev)} data-umami-event="roadmap-prev">← Step {prev.step}</a>}
      <button class="btn rm-mark" type="button" data-n={t.n} aria-pressed="false">Mark as done</button>
      {next && <a class="btn" href={themeUrl(next)} data-umami-event="roadmap-next">Step {next.step} →</a>}
      <a class="small" href={u('/roadmap/')}>See the full roadmap</a>
    </div>
  </div>
  <p><button class="btn" type="button" data-share>Share this theme</button></p>

  {cv && <>
    <h2>Study in this order</h2>
    <ol class="order">
      {cv.ncert.length > 0 && <li><b>Basics from NCERT</b>{cv.ncert.map((x) => <span>{x.book}: {x.ch}</span>)}</li>}
      {cv.book.length > 0 && <li><b>Standard book</b><span>M. Laxmikanth, <i>Indian Polity</i>: {cv.book.join('; ')}</span></li>}
      {cv.bare.length > 0 && <li><b>Bare Act</b>{cv.bare.map((x) => <span><a href={x.url} target="_blank" rel="noopener">{x.t}</a></span>)}</li>}
      <li><b>Prelims PYQs</b><span>{preQs.length ? <a href="#prelims">{preQs.length} questions with answers, below</a> : 'None linked to this theme yet'}</span></li>
      <li><b>Mains PYQs</b><span>{t.count ? <a href="#mains">{t.count} questions, below</a> : 'None asked on this theme alone yet'}</span></li>
    </ol>
  </>}

  {cv && cv.sections.length > 0 && <>
    <h2>Full syllabus coverage</h2>
    <p class="lead">Everything this part of the syllabus covers. The tags count this theme's PYQs, plus a few questions filed under a linked theme that test the same point. Start with the tagged lines, then cover the rest: UPSC keeps asking new corners.</p>
    {cv.sections.map((sec) => <>
      <h3>{sec.h}</h3>
      <ul class="cov">{sec.items.map((x) => { const g = tag(x); return <li><span>{x.t}</span>{g ? <span class="ask">{g}</span> : g === '' ? <span class="ask none">No PYQ here yet</span> : null}</li>; })}</ul>
    </>)}
  </>}

  <h2>What UPSC asks</h2>
  <p>{t.asks}</p>

  <h2>{cv ? 'Mains focus' : 'Prepare these'}</h2>
  <ul>{t.checklist.map((x) => <li>{x}</li>)}</ul>

  <h2>Answer writing</h2>
  <ul>{t.answer.map((x) => <li>{x}</li>)}</ul>
  {t.directives.length > 0 && <p class="lead">Directive words in these PYQs: {t.directives.map(([d, c]) => `${d} (${c})`).join(', ')}.</p>}

  {linked.length > 0 && <>
    <h2>Linked themes</h2>
    {buildsOn.length > 0 && <>
      <h3>Builds on: study these first</h3>
      <p class="lead">These come earlier in the roadmap. Questions in this theme use them.</p>
      <div class="chips">{buildsOn.map((l) => <a class="chip" href={themeUrl(l)} data-umami-event="linked-theme-click" data-umami-event-from={`T${t.n}`} data-umami-event-to={`T${l.n}`}>Step {l.step}: {l.title}</a>)}</div>
    </>}
    {comesBack.length > 0 && <>
      <h3>Comes back later in</h3>
      <p class="lead">Later themes that take this one further.</p>
      <div class="chips">{comesBack.map((l) => <a class="chip" href={themeUrl(l)} data-umami-event="linked-theme-click" data-umami-event-from={`T${t.n}`} data-umami-event-to={`T${l.n}`}>Step {l.step}: {l.title}</a>)}</div>
    </>}
  </>}

  {(mapLinks.mods.length > 0 || mapLinks.cards.length > 0) && <>
    <h2>On the map</h2>
    <div class="chips">
      {mapLinks.mods.map((m) => <a class="chip" href={m.url} data-umami-event="theme-map-click" data-umami-event-from={`T${t.n}`} data-umami-event-to={`module-${m.n}`}>Map module {m.n}: {m.name}</a>)}
      {mapLinks.cards.map((c) => <a class="chip" style="font-weight:700" href={`${u('/maps/lab/')}#${c.id}`} data-umami-event="theme-map-click" data-umami-event-from={`T${t.n}`} data-umami-event-to="lab">Practise in the sketch lab: {c.q.paper} {c.q.year}</a>)}
    </div>
  </>}

  <h2>Syllabus lines covered</h2>
  <ul>{syl.map((s) => <li><a href={u(`/syllabus/${s.id.toLowerCase()}/`)}>{s.id}</a> — {s.text}</li>)}</ul>

  {preQs.length > 0 && <>
    <h2 id="prelims">{preQs.length} Prelims PYQs, newest first</h2>
    <ol class="qs">{preQs.map((q, i) => <PrelimsItem q={q} n={i + 1} showYear />)}</ol>
  </>}

  <h2 id="mains">{t.count ? `All ${t.count} Mains PYQs, newest first` : 'Mains PYQs'}</h2>
  {t.count ? <ol class="qs">{t.questions.map((q) => <QuestionItem q={q} />)}</ol>
    : <p>Mains has not asked about this theme on its own yet. Its ideas come up inside the questions of the themes that follow it on the roadmap.</p>}

  <nav class="panel rmnext" aria-label="Roadmap">
    <p class="eyebrow">Next on the roadmap</p>
    {next ? <a href={themeUrl(next)} data-umami-event="roadmap-next">Step {next.step}: {next.title} →</a> : <a href={u('/roadmap/')}>You've reached the last step. Back to the roadmap</a>}
    {prev && <a class="small" href={themeUrl(prev)}>← Step {prev.step}: {prev.title.split(':')[0]}</a>}
  </nav>
  <style>
    .rmbar { margin: 12px 0; display: grid; gap: 8px; } .rmbar p { margin: 0; }
    .rmbtns { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .rmbtns .btn { text-decoration: none; }
    .rm-mark[aria-pressed="true"] { background: var(--gs1); border-color: var(--gs1); color: var(--surface); }
    .rmnext { margin-top: 28px; display: grid; gap: 6px; } .rmnext p { margin: 0; }
    .rmnext > a:first-of-type { font-weight: 700; font-size: 1.05rem; }
    .small { font-size: .86rem; }
    .order { list-style: none; counter-reset: o; padding: 0; margin: 0 0 8px; display: grid; gap: 8px; }
    .order li { counter-increment: o; position: relative; padding: 10px 14px 10px 50px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); display: grid; gap: 2px; }
    .order li::before { content: counter(o); position: absolute; left: 12px; top: 10px; width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--omr); color: var(--omr); display: grid; place-items: center; font-weight: 800; font-size: .82rem; }
    .order b { font-size: .98rem; } .order span { color: var(--muted); font-size: .92rem; line-height: 1.45; }
    .cov { list-style: none; padding: 0; margin: 0 0 6px; display: grid; gap: 0; }
    .cov li { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 12px; padding: 8px 0; border-bottom: 1px solid var(--line); }
    .cov li > span:first-child { flex: 1 1 280px; min-width: 0; }
    .ask { flex: none; font-size: .76rem; font-weight: 700; border-radius: 999px; padding: 2px 9px; background: var(--omr-soft); color: var(--omr); white-space: nowrap; }
    .ask.none { background: transparent; color: var(--muted); border: 1px dashed var(--line); font-weight: 600; }
  </style>
  <script is:inline>
    (function () {
      var b = document.querySelector('.rm-mark'); if (!b) return;
      var n = Number(b.dataset.n), done = [];
      try { done = JSON.parse(localStorage.getItem('upscthemes-done') || '[]'); } catch (e) {}
      function paint() { var on = done.indexOf(n) > -1; b.setAttribute('aria-pressed', on ? 'true' : 'false'); b.textContent = on ? 'Done ✓' : 'Mark as done'; }
      paint();
      b.addEventListener('click', function () {
        var i = done.indexOf(n); if (i > -1) done.splice(i, 1); else done.push(n);
        try { localStorage.setItem('upscthemes-done', JSON.stringify(done)); } catch (e) {}
        paint();
        if (window.__track) window.__track(i > -1 ? 'roadmap-undone' : 'roadmap-done', { theme: 'T' + n });
      });
    })();
  </script>
</Base>

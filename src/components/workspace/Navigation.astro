---
import { u } from '../../lib/data';
interface Props { label: string }
const { label } = Astro.props;
const path = Astro.url.pathname;
const groups = [
  { name: 'Study', links: [
    { label: 'Home', href: '/', icon: '<path d="m3 10 9-7 9 7v10H3z"/><path d="M9 20v-7h6v7"/>' },
    { label: 'Today', href: '/daily/', icon: '<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 3v4m8-4v4M4 11h16m-11 5 2 2 4-4"/>' },
    { label: 'Learn', href: '/learn/', icon: '<path d="M12 5v16M3 4c4-1 6 0 9 2 3-2 5-3 9-2v15c-4-1-6 0-9 2-3-2-5-3-9-2z"/>' },
    { label: 'Questions', href: '/questions/', icon: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6m-6 4h6m-6 4h3"/>' },
    { label: 'Themes', href: '/themes/', icon: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>' },
    { label: 'Maps', href: '/maps/', icon: '<path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3zM9 3v15m6-12v15"/>' },
  ] },
  { name: 'Reference', links: [
    { label: 'Syllabus', href: '/syllabus/', icon: '<path d="M8 3h11v18H5V6zm0 0v4H5m3 4h8m-8 4h8m-8 4h5"/>' },
    { label: 'Good Reads', href: '/sources/', icon: '<path d="M4 4h12v16H4zM8 8h4m-4 4h4M16 8h4v13H8"/>' },
  ] },
];
function active(href: string) {
  const routes = href === '/learn/' ? ['/learn/', '/stage-0/', '/roadmap/'] : href === '/questions/' ? ['/questions/', '/prelims/', '/mains/', '/papers/'] : [href];
  return routes.some((h) => h === '/' ? path === u('/') : path.startsWith(u(h)));
}
---
<nav class="workspace-nav" aria-label={label}>
  {groups.map((group) => <div class="nav-group"><p>{group.name}</p>{group.links.map((link) => <a href={u(link.href)} aria-current={active(link.href) ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={link.icon}/><span>{link.label}</span></a>)}</div>)}
</nav>
<style>
  .nav-group { margin-bottom: 24px; }
  .nav-group p { color: var(--muted); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; margin: 0 12px 8px; font-weight: 600; }
  a { display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 9px 12px; margin: 3px 0; border-radius: 5px; color: var(--muted); text-decoration: none; font-size: .94rem; font-weight: 500; border-left: 2px solid transparent; }
  a:hover { color: var(--ink); background: var(--hover); }
  a[aria-current] { background: var(--hover); color: var(--ink); border-left-color: var(--accent); font-weight: 650; }
  svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; flex: none; }
</style>

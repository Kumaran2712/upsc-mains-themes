---
import { maps } from '../../lib/maps';
interface Props { id: string; title?: string; data?: 'history' | 'news' }
const { id, title = 'World map with places from modern world history', data = 'history' } = Astro.props;
const m = (maps as any)[data];
---
<svg id={id} class="map map-hist" viewBox={m.viewBox} role="img" aria-label={title} preserveAspectRatio="xMidYMid meet">
  <title>{title}</title>
  <rect class="sea" x="0" y="0" width="100%" height="100%" />
  <g class="cts">{m.countries.map((c: any) => <path class="ct" data-name={c.name} data-cont={c.cont} d={c.d}><title>{c.name}</title></path>)}</g>
  <path class="india" d={m.india} />
  <g class="pts">{m.pins.map((p: any) => <g class="pt" data-name={p.name}><circle cx={p.x} cy={p.y} r="14" class="hit" /><circle cx={p.x} cy={p.y} r="5.5" class="dot" /><title>{p.name}</title></g>)}</g>
  <g class="lab">{m.pins.map((p: any) => <text x={p.x + 8} y={p.y - 7} data-for={p.name}>{p.name}</text>)}</g>
</svg>

---
import { maps } from '../../lib/maps';
interface Props { id: string; labels?: boolean; title?: string }
const { id, labels = true, title = 'World map with major straits and chokepoints' } = Astro.props;
const m = maps.world;
---
<svg id={id} class="map map-world" viewBox={m.viewBox} role="img" aria-label={title} preserveAspectRatio="xMidYMid meet">
  <title>{title}</title>
  <rect class="sea" x="0" y="0" width="100%" height="100%" />
  <path class="land" d={m.land} />
  <path class="india" d={m.india} />
  <g class="pts">{m.chokepoints.map((c: any) => <g class="pt" data-name={c.name}><circle cx={c.x} cy={c.y} r="16" class="hit" /><circle cx={c.x} cy={c.y} r="6" class="dot" /><title>{c.name}</title></g>)}</g>
  {labels && <g class="lab">{m.chokepoints.map((c: any) => <text x={c.x + c.dx} y={c.y + c.dy} text-anchor={c.anchor} class={c.minor ? 'minor' : undefined} data-for={c.name}>{c.name}</text>)}</g>}
</svg>

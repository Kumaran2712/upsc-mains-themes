---
import { maps } from '../../lib/maps';
interface Props { id: string; labels?: boolean; extras?: boolean; rivers?: boolean; layers?: string; title?: string }
const { id, labels = true, extras = true, rivers = false, title = 'Map of India with state boundaries' } = Astro.props;
const R = rivers ? maps.drainage.rivers : [];
const { layers } = Astro.props;
// Layer content: one module (layers = slug) or all modules (layers = '*', for the sketch lab).
const LM = !layers ? [] : maps.layerModules.filter((mm: any) => layers === '*' || mm.slug === layers);
const LL = LM.flatMap((mm: any) => mm.layers.map((l: any) => ({ ...l, key: layers === '*' ? `${mm.slug}/${l.id}` : l.id })));
const feats = LL.filter((l: any) => l.kind === 'features'), lines = LL.filter((l: any) => l.kind === 'lines'), pins = LL.filter((l: any) => l.kind === 'pins');
const m = maps.india;
const big = m.states.filter((s: any) => s.area > 2.5);
---
<svg id={id} class="map map-india" viewBox={m.viewBox} role="img" aria-label={title} preserveAspectRatio="xMidYMid meet">
  <title>{title}</title>
  {LL.length > 0 && <defs><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" class="arrowhead" /></marker></defs>}
  {extras && <path class="grat" d={m.graticule} />}
  <g class="states">{m.states.map((s: any) => <path class="st" data-name={s.name} d={s.d}><title>{s.name}</title></path>)}</g>
  <path class="ol" d={m.outline} />
  {rivers && <g class="rvs">{R.map((r: any) => <path class="rv" data-name={r.name} data-group={r.group} data-flows={r.flows} d={r.d}><title>{r.name}</title></path>)}</g>}
  {rivers && <g class="rvlab">{R.map((r: any) => <text x={r.cx} y={r.cy} data-for={r.name}>{r.name}</text>)}</g>}
  {extras && <>
    <g class="tropic"><path d={m.tropic} /><text x={m.tropicLabel.x} y={m.tropicLabel.y}>Tropic of Cancer</text></g>
    <g class="meridian"><path d={m.meridian} /><text x={m.meridianLabel.x} y={m.meridianLabel.y}>82°30′E</text></g>
    <g class="gratlab">{m.latLabels.map((l: any) => <text x={l.x} y={l.y}>{l.t}</text>)}{m.lonLabels.map((l: any) => <text x={l.x} y={l.y} text-anchor="middle">{l.t}</text>)}</g>
    <g class="ext">{m.extremes.map((e: any) => { const L = e.label; const end = L === 'Easternmost' || L === 'Southernmost'; const dy = L === 'Northernmost' ? 32 : L.startsWith('Southernmost') ? -14 : 9; return <g><circle cx={e.x} cy={e.y} r="9" /><text x={e.x + (end ? -14 : 14)} y={e.y + dy} text-anchor={end ? 'end' : 'start'}>{L.replace(' (mainland)', '*')}</text></g>; })}</g>
  </>}
  {feats.length > 0 && <g class="fts">{feats.map((l: any) => l.items.map((it: any) => <path class="ft" data-layer={l.key} data-name={it.name} d={it.d}><title>{it.name}</title></path>))}</g>}
  {lines.length > 0 && <g class="lns">{lines.map((l: any) => l.items.map((it: any) => <path class="ln" data-layer={l.key} data-name={it.name} d={it.d} marker-end="url(#arrow)"><title>{it.name}</title></path>))}</g>}
  {pins.length > 0 && <g class="pts">{pins.map((l: any) => l.items.map((it: any) => <g class="pt" data-layer={l.key} data-name={it.name}><circle cx={it.x} cy={it.y} r="20" class="hit" /><circle cx={it.x} cy={it.y} r="8" class="dot" /><title>{it.name}</title></g>))}</g>}
  {LL.length > 0 && <g class="lab llab">{[...feats, ...lines, ...pins].map((l: any) => l.items.map((it: any) => <text x={(it.x ?? it.cx) + (it.x != null ? 12 : 0)} y={(it.y ?? it.cy) + (it.x != null ? -10 : 0)} text-anchor={it.x != null ? 'start' : 'middle'} data-layer={l.key} data-for={it.name}>{it.name}</text>))}</g>}
  {labels && <g class="lab">{big.map((s: any) => <text x={s.cx} y={s.cy} text-anchor="middle">{s.name}</text>)}</g>}
</svg>

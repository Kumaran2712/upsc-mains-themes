<style is:global>
  .mapbox { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 8px; }
  .map { display: block; width: 100%; height: auto; max-height: 78vh; touch-action: manipulation; }
  .map text { font-family: var(--f-body); paint-order: stroke; stroke: var(--surface); stroke-width: 4px; fill: var(--ink); }
  .map-india .st { fill: var(--surface); stroke: var(--muted); stroke-width: 1; vector-effect: non-scaling-stroke; cursor: pointer; }
  .map-india .st:hover { fill: var(--accent-soft); }
  .map-india .ol { fill: none; stroke: var(--ink); stroke-width: 1.6; vector-effect: non-scaling-stroke; pointer-events: none; }
  .map-india .grat { fill: none; stroke: var(--line); stroke-width: 1; vector-effect: non-scaling-stroke; pointer-events: none; }
  .map-india .tropic path { fill: none; stroke: var(--gs3); stroke-width: 2; stroke-dasharray: 6 4; vector-effect: non-scaling-stroke; }
  .map-india .meridian path { fill: none; stroke: var(--gs2); stroke-width: 2; stroke-dasharray: 6 4; vector-effect: non-scaling-stroke; }
  .map-india .tropic text { fill: var(--gs3); font-size: 30px; font-weight: 700; }
  .map-india .meridian text { fill: var(--gs2); font-size: 30px; font-weight: 700; }
  .map-india .gratlab text { font-size: 26px; fill: var(--muted); }
  .map-india .ext circle { fill: var(--gs1); }
  .map-india .ext text { font-size: 26px; font-weight: 700; fill: var(--gs1); }
  .map-india .lab text { font-size: 24px; pointer-events: none; fill: var(--muted); }
  .map-india .tropic, .map-india .meridian, .map-india .ext, .map-india .gratlab { pointer-events: none; }
  .map-india .st.on1 { fill: var(--gs1-bg); stroke: var(--gs1); }
  .map-india .st.on2 { fill: var(--gs3-bg); stroke: var(--gs3); }
  .map-india .st.right { fill: var(--gs1); } .map-india .st.wrong { fill: var(--gs3); }
  .map-world .sea, .map-region .sea { fill: var(--accent-soft); }
  .map-world .land { fill: var(--surface); stroke: var(--muted); stroke-width: .6; }
  .map-world .india, .map-region .india { fill: var(--gs2-bg); stroke: var(--gs2); stroke-width: 1.2; vector-effect: non-scaling-stroke; }
  .map-world .pt { cursor: pointer; } .map-world .pt .hit { fill: transparent; } .map-world .pt .dot { fill: var(--gs3); stroke: var(--surface); stroke-width: 1.5; }
  .map-world .pt.sel .dot, .map-world .pt.on1 .dot { fill: var(--gs1); stroke-width: 3; }
  .map-world .lab text { font-size: 20px; font-weight: 600; pointer-events: none; } .map-world .lab text.minor { font-size: 15px; }
  .map-world.compact .lab text.minor:not(.show) { display: none; }
  .map-region .nb { fill: var(--surface); stroke: var(--muted); stroke-width: 1; vector-effect: non-scaling-stroke; cursor: pointer; }
  .map-region .nb:hover, .map-region .nb.sel { fill: var(--gs3-bg); stroke: var(--gs3); }
  .map-region .lab text { font-size: 26px; font-weight: 600; pointer-events: none; } .map-region .lab .in { fill: var(--gs2); font-size: 32px; letter-spacing: .12em; }
  /* India rivers */
  .map-india .rv { fill: none; stroke: #3b82c4; stroke-width: 2; vector-effect: non-scaling-stroke; cursor: pointer; }
  .map-india .rvs .rv:hover { stroke-width: 4; }
  .map-india .rvlab text { font-size: 22px; font-weight: 600; fill: #2a6aa8; display: none; pointer-events: none; }
  .map-india.show-rvlab .rvlab text, .map-india .rvlab text.show { display: inline; }
  .map-india.by-group .rv[data-group="himalayan"] { stroke: var(--gs1); } .map-india.by-group .rv[data-group="peninsular"] { stroke: var(--gs3); }
  .map-india.by-flow .rv[data-flows="east"] { stroke: var(--gs2); } .map-india.by-flow .rv[data-flows="west"] { stroke: var(--gs3); } .map-india.by-flow .rv[data-flows="north"] { stroke: var(--gs1); }
  /* World physical */
  .map-phys .sea, .map-hist .sea { fill: var(--accent-soft); }
  .map-phys .land { fill: var(--surface); stroke: var(--muted); stroke-width: .6; }
  .map-phys .sf { fill: transparent; cursor: pointer; }
  .map-phys .lines path { fill: none; stroke: var(--muted); stroke-width: 1; stroke-dasharray: 5 4; vector-effect: non-scaling-stroke; pointer-events: none; }
  .map-phys .lines .eq { stroke: var(--ink); }
  .map-phys .ft { cursor: pointer; stroke-width: .8; }
  .map-phys .k-range { fill: #a0714f; stroke: #7c5133; } .map-phys .k-desert { fill: #e8c46a; stroke: #b8902f; }
  .map-phys .k-plateau { fill: #c49c7a; stroke: #946b4a; } .map-phys .k-plain, .map-phys .k-basin { fill: #9bc489; stroke: #5f9050; }
  .map-phys .rv { fill: none; stroke: #3b82c4; stroke-width: 1.6; vector-effect: non-scaling-stroke; cursor: pointer; }
  .map-phys .india, .map-hist .india { fill: none; stroke: var(--gs2); stroke-width: 1.4; vector-effect: non-scaling-stroke; pointer-events: none; }
  .map-phys .lab text, .map-hist .lab text { font-size: 17px; font-weight: 600; display: none; pointer-events: none; }
  .map-phys .lab text.show, .map-hist .lab text.show, .show-lab .lab text { display: inline; }
  .off-range .k-range, .off-desert .k-desert, .off-plateau .k-plateau, .off-plain .k-plain, .off-plain .k-basin, .off-rivers .wrv, .off-lines .lines { display: none; }
  .map-phys .sf.sel, .map-phys .sf.on1 { fill: var(--gs1-bg); stroke: var(--gs1); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .map-phys .sf.on2 { fill: var(--gs3-bg); stroke: var(--gs3); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .map-phys .ft.sel, .map-phys .ft.on1 { fill: var(--gs1); stroke: var(--ink); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .map-phys .ft.on2 { fill: var(--gs3); stroke: var(--ink); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .map-phys .rv.sel, .map-phys .rv.on1 { stroke: var(--gs1); stroke-width: 3.5; }
  /* World history */
  .map-hist .ct { fill: var(--surface); stroke: var(--line); stroke-width: .6; vector-effect: non-scaling-stroke; cursor: pointer; }
  .map-hist .ct.on1, .map-hist .ct.sel { fill: var(--gs1-bg); stroke: var(--gs1); stroke-width: 1.4; }
  .map-hist .ct.on2 { fill: var(--gs3-bg); stroke: var(--gs3); stroke-width: 1.4; }
  .map-hist .pt { cursor: pointer; } .map-hist .pt .hit { fill: transparent; } .map-hist .pt .dot { fill: var(--gs3); stroke: var(--surface); stroke-width: 1.5; }
  .map-hist .pt.sel .dot, .map-hist .pt.on1 .dot, .map-hist .pt.on2 .dot { fill: var(--gs1); stroke-width: 3; }
  /* Lab mode: hide pins and labels until reveal */
  .labonly .pt { display: none; } .labonly .pt.on1, .labonly .pt.on2 { display: inline; }
  .labonly .lab text, .labonly .rvlab text { display: none; } .labonly .lab text.show, .labonly .rvlab text.show { display: inline; }
  .map-india .rv.on1 { stroke: var(--gs1); stroke-width: 4; } .map-india .rv.on2 { stroke: var(--gs3); stroke-width: 4; }
  .labonly .rv, .labonly .ft { display: none; } .labonly .rv.on1, .labonly .rv.on2, .labonly .ft.on1, .labonly .ft.on2 { display: inline; }
  .quizzing .lab text, .quizzing .rvlab text { display: none !important; }
  .mapbox.zoomed { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .mapbox.zoomed > svg { width: 230%; max-width: none; max-height: none; }
  /* Layered India modules */
  .map-india .ft { fill: #b08a68; fill-opacity: .55; stroke: #7c5133; stroke-width: 1; vector-effect: non-scaling-stroke; cursor: pointer; }
  .map-india .ln { fill: none; stroke: var(--gs2); stroke-width: 3.5; stroke-linecap: round; vector-effect: non-scaling-stroke; cursor: pointer; }
  .map-india .arrowhead { fill: var(--gs2); }
  .map-india .rvl .rline { fill: none; stroke: #2f7fc1; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .map-india .rvl.sch .rline { stroke-dasharray: 7 5; }
  .map-india .rvl .hitl { fill: none; stroke: transparent; stroke-width: 16; vector-effect: non-scaling-stroke; cursor: pointer; pointer-events: stroke; }
  .map-india .rvl.sel .rline, .map-india .rvl.on1 .rline { stroke: var(--gs1); stroke-width: 4.5; } .map-india .rvl.on2 .rline { stroke: var(--gs3); stroke-width: 4.5; }
  .map-india .rvl[data-layer] { display: none; } .map-india .rvl.act, .quiz-all .rvl[data-layer] { display: inline !important; }
  .map-india .pt { cursor: pointer; } .map-india .pt .hit { fill: transparent; } .map-india .pt .dot { fill: var(--gs3); stroke: var(--surface); stroke-width: 2.5; }
  .map-india .llab text { font-size: 22px; font-weight: 600; display: none; pointer-events: none; }
  .map-india .ft[data-layer], .map-india .ln[data-layer], .map-india .pt[data-layer] { display: none; }
  .map-india .ft.act, .map-india .ln.act, .map-india .pt.act { display: inline !important; }
  .show-names .llab text.act, .map-india .llab text.show { display: inline !important; }
  .quiz-all .ft[data-layer], .quiz-all .ln[data-layer], .quiz-all .pt[data-layer] { display: inline !important; }
  .map-india .st.g1 { fill: var(--gs1-bg); stroke: var(--gs1); } .map-india .st.g2 { fill: var(--gs3-bg); stroke: var(--gs3); }
  .map-india .ft.sel, .map-india .ft.on1 { fill: var(--gs1); fill-opacity: .8; } .map-india .ft.on2 { fill: var(--gs3); fill-opacity: .8; }
  .map-india .ln.sel, .map-india .ln.on1 { stroke: var(--gs1); stroke-width: 5; } .map-india .ln.on2 { stroke: var(--gs3); stroke-width: 5; }
  .map-india .pt.sel .dot, .map-india .pt.on1 .dot { fill: var(--gs1); } .map-india .pt.on2 .dot { fill: var(--gs2); }
  .labonly .ft[data-layer].on1, .labonly .ft[data-layer].on2, .labonly .ln[data-layer].on1, .labonly .ln[data-layer].on2, .labonly .pt[data-layer].on1, .labonly .pt[data-layer].on2 { display: inline !important; }
  .labonly .llab text.show { display: inline !important; }
  .hide-grid .grat, .hide-grid .gratlab, .hide-tropic .tropic, .hide-meridian .meridian, .hide-ext .ext, .hide-lab .lab { display: none; }
  .maptools { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
  .tog { font: inherit; font-size: .82rem; font-weight: 600; padding: 4px 10px; border-radius: 99px; border: 1px solid var(--line); background: var(--surface); color: var(--muted); cursor: pointer; }
  .tog[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--surface); }
  .attrib { font-size: .76rem; color: var(--muted); margin: 6px 0 0; }
  .infocard { margin-top: 10px; }
  .infocard h3 { margin: 0 0 4px; }
  .quiz { display: grid; gap: 6px; margin-top: 10px; }
  .quiz .ask { font-weight: 700; font-size: 1.05rem; }
  .quiz .fb { min-height: 1.4em; font-weight: 600; }
  .fb.ok { color: var(--gs1); } .fb.no { color: var(--gs3); }
</style>

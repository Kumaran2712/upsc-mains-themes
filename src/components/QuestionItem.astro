---
import { byN, themeUrl, issueUrl, qUrl, type Question } from '../lib/data';
interface Props { q: Question; showTheme?: { title: string; href: string } }
const { q, showTheme } = Astro.props;
const issue = issueUrl('PYQ check: ' + q.id, 'Question ID: ' + q.id + '\nWhat looks wrong:\n');
---
<li class="q" id={q.id}>
  <div class="qm">
    <span class={`pc ${q.paper.toLowerCase()}`}>{q.paper}</span>
    <span class="yr">{q.year}</span>
    {q.marks && <span>{q.marks} marks{q.words ? ` · ${q.words} words` : ''}</span>}
    <span class="qid">{q.id}</span>
  </div>
  <p><a class="qlink" href={qUrl(q)}>{q.text}</a></p>
  {showTheme && <p class="eyebrow">Theme: <a href={showTheme.href}>{showTheme.title}</a></p>}
  <div class="qa">
    {q.also.map((n) => { const t = byN.get(n)!; return <a class="chip" href={themeUrl(t)} data-umami-event="also-needs-click" data-umami-event-from={q.id} data-umami-event-to={`T${n}`}>Also needs: T{n} {t.title}</a>; })}
    <button class="btn" type="button" data-copy={`${q.text} (UPSC CSE Mains ${q.year}, ${q.paper})`} data-qid={q.id}>Copy</button>
    {issue && <a class="small" href={issue} rel="noopener nofollow" data-umami-event="report-error" data-umami-event-where={q.id}>Report a typo</a>}
  </div>
</li>

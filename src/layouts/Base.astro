---
import Navigation from '../components/workspace/Navigation.astro';
import ActivityProgress from '../components/ActivityProgress.astro';
import AccountControls from '../components/stage0/AccountControls.astro';
import LearningStyles from '../components/stage0/Styles.astro';
import { u, issueUrl } from '../lib/data';
interface Props {
  title: string;            // page-specific part of the <title>
  description: string;
  jsonld?: object[];
  noindex?: boolean;
  brand?: boolean;          // append ' | UPSC Themes' to the <title>
  focusMode?: boolean;      // give concept conversations the full mobile viewport
  crumbs?: { name: string; href: string }[];
}
const { title, description, jsonld = [], noindex = false, crumbs = [], brand = true, focusMode = false } = Astro.props;
const SITE_NAME = 'UPSC Themes';
const fullTitle = !brand ? title : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(u('/og.png'), Astro.site).href;
// Accept either the bare ID or a pasted tracking snippet: keep only the UUID.
const umamiId = (String(import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || '').match(/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i) || [])[0];
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC || 'https://cloud.umami.is/script.js';
// Search Console: one or more codes (comma-separated); each may be the bare code or a pasted <meta> tag.
const gscRaw = String(import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '');
const gscTokens = [...new Set(gscRaw.split(',').map((x) => ((x.match(/content="([^"]+)"/) || [])[1] || x).trim()).filter((x) => /^[\w-]{20,}$/.test(x)))];
const crumbLd = crumbs.length
  ? [{
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: u('/') }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, Astro.site).href })),
    }]
  : [];
const ld = [...crumbLd, ...jsonld];
const path = Astro.url.pathname;
const section = path.includes('/stage-0/') ? 'Learn / Foundations' : path.includes('/roadmap/') ? 'Learn / Roadmap' : path.includes('/sources/') ? 'Good Reads' : path.includes('/syllabus/') ? 'Syllabus' : path.includes('/daily/') ? 'Today' : path.includes('/learn/') ? 'Learn' : path.includes('/themes/') ? 'Themes' : path.includes('/maps/') ? 'Maps' : path.includes('/search/') ? 'Search' : /^\/(questions|prelims|mains|papers)\//.test(path) ? 'Questions' : path === u('/') ? 'Home' : 'UPSC Themes';

---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  {gscTokens.map((t) => <meta name="google-site-verification" content={t} />)}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="en_IN" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#fafaf9" />
  <script is:inline>
    (function () {
      var preference;
      try { preference = localStorage.getItem('upscthemes-theme'); } catch (e) {}
      var theme = preference === 'light' || preference === 'dark' ? preference : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#121210' : '#fafaf9';
    })();
  </script>
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={u('/sitemap-index.xml')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" />
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  {umamiId && <script defer src={umamiSrc} data-website-id={umamiId} data-do-not-track="true"></script>}
</head>
<body class:list={{ 'focus-mode': focusMode }}>
  <a class="skip" href="#main">Skip to content</a>
  <aside class="workspace-sidebar" aria-label="Study workspace">
    <a class="brand" href={u('/')}><span class="brand-symbol" aria-hidden="true">U</span>UPSC Themes</a>
    <Navigation label="Main" />
    <div class="sidebar-foot"><a href={u('/about/')}>About & sources</a><span>Free to learn. At your pace.</span></div>
  </aside>
  <header class="top">
    <div class="topin">
      <button type="button" class="icon-button mobile-menu" data-menu-open aria-label="Open navigation" aria-haspopup="dialog" aria-controls="workspace-menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      <a class="toolbar-home" href={u('/')} aria-label="UPSC Themes home">UPSC Themes</a>
      <span class="toolbar-section">{section}</span>
      <a class="searchbtn" href={u('/search/')} aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg><span>Search anything</span></a>
      <button type="button" class="icon-button" data-theme-toggle aria-label="Switch to dark theme" aria-pressed="false"><svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5a8.5 8.5 0 1 0 9.5 9.5Z"/></svg><svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></button>
    </div>
  </header>
  <dialog id="workspace-menu" class="workspace-menu" aria-labelledby="workspace-menu-title">
    <div class="menu-heading"><h2 id="workspace-menu-title">UPSC Themes</h2><button type="button" class="icon-button" data-menu-close aria-label="Close navigation">×</button></div>
    <Navigation label="Mobile navigation" />
    <a class="menu-about" href={u('/about/')}>About & sources</a>
  </dialog>
  <nav class="tabbar" aria-label="Sections">
    <a href={u('/')} aria-current={path === u('/') ? 'page' : undefined}>Home</a>
    <a href={u('/daily/')} aria-current={path.startsWith(u('/daily/')) ? 'page' : undefined}>Today</a>
    <a href={u('/learn/')} aria-current={['/learn/', '/stage-0/', '/roadmap/'].some((h) => path.startsWith(u(h))) ? 'page' : undefined}>Learn</a>
    <button type="button" data-menu-open aria-label="More navigation" aria-haspopup="dialog" aria-controls="workspace-menu">More <span aria-hidden="true">☰</span></button>
  </nav>
  <noscript>
    <div class="workspace-no-script"><Navigation label="Navigation without JavaScript" /></div>
    <style is:inline>.mobile-menu, [data-theme-toggle], .tabbar button, .s0-account, .activity-progress { display: none !important; } .tabbar { grid-template-columns: repeat(3, 1fr); }</style>
  </noscript>
  <main id="main" class="wrap" tabindex="-1">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={u('/')}>Home</a>
        {crumbs.map((c, i) => <>
          <span aria-hidden="true">/</span>
          {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}
        </>)}
      </nav>
    )}
    {!path.includes('/stage-0/') && <div class="s0"><LearningStyles /><AccountControls compact /></div>}
    {!path.includes('/stage-0/') && <ActivityProgress />}
    <slot />
  </main>
  <footer class="foot">
    <div class="wrap">
      <p>Free and non-commercial. Questions are from the Civil Services (Main) papers published by the <a href="https://www.upsc.gov.in/examinations/previous-question-papers" rel="noopener" data-umami-event="outbound-upsc">Union Public Service Commission</a>. Theme analysis and prep notes are this site's own.</p>
      <p class="footnav"><a href={u('/papers/gs1/')}>Mains papers</a><a href={u('/syllabus/')}>Syllabus</a><a href={u('/sources/')}>Good reads</a><a href={u('/themes/')}>All themes</a><a href={u('/about/')}>About & sources</a></p>
      <p><a href={u('/about/')}>Privacy</a>{issueUrl() && <> · <a href={issueUrl()} rel="noopener" data-umami-event="report-error" data-umami-event-where="footer">Report an error</a></>}</p>
    </div>
  </footer>
  <script>
    import { initialiseWorkspace } from '../lib/client/workspace';
    initialiseWorkspace();
  </script>
  <script is:inline>
    // Tracked actions that need script (copy, share). Umami's `umami` global is absent until it loads or if blocked.
    (function () {
      function track(name, data) { try { if (window.umami) window.umami.track(name, data); } catch (e) {} }
      document.addEventListener('click', function (e) {
        var b = e.target.closest('[data-copy]');
        if (b) {
          var text = b.getAttribute('data-copy');
          var done = function () { var t = b.textContent; b.textContent = 'Copied'; setTimeout(function () { b.textContent = t; }, 1500); };
          if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, function () {});
          track('copy-question', { id: b.getAttribute('data-qid') });
        }
        var s = e.target.closest('[data-share]');
        if (s) {
          var url = location.href, title = document.title;
          if (navigator.share) { navigator.share({ title: title, url: url }).catch(function () {}); }
          else if (navigator.clipboard) { navigator.clipboard.writeText(url).then(function () { var t = s.textContent; s.textContent = 'Link copied'; setTimeout(function () { s.textContent = t; }, 1500); }, function () {}); }
          track('share', { page: location.pathname });
        }
      });
      document.addEventListener('click', function (e) {
        var z = e.target.closest('.zoombtn'); if (!z) return;
        var svg = document.getElementById(z.getAttribute('data-for')); if (!svg) return;
        var box = svg.parentElement, on = z.getAttribute('aria-pressed') !== 'true';
        z.setAttribute('aria-pressed', on ? 'true' : 'false'); box.classList.toggle('zoomed', on);
        if (on) box.scrollLeft = (box.scrollWidth - box.clientWidth) * 0.55;
      });
      window.__track = track;
    })();
  </script>
</body>
</html>

<style is:global>
  /* Shared workspace tokens. Subject and feedback colors retain their semantic meaning. */
  :root {
    --bg: #fafaf9; --surface: #ffffff; --ink: #20211f; --muted: #61645e; --line: #e3e4df; --line-strong: #b9bdb5; --hover: #eeefeb;
    --accent: #29616a; --accent-ink: #ffffff; --accent-soft: #eaf1f1; --omr: #655c73; --omr-soft: #f0edf3; --action: #242522; --action-ink: #ffffff;
    --ok: #0f7a55; --ok-soft: #e1f4ec; --no: #bf3329; --no-soft: #fbe6e4;
    --gs1: #0b7666; --gs1-bg: #dff2ee; --gs2: #6236c4; --gs2-bg: #ece6fb; --gs3: #a15c00; --gs3-bg: #fbeedb; --hl: #fff1a8;
    --f-display: "Figtree", system-ui, sans-serif; --f-body: "Figtree", system-ui, sans-serif; --f-mono: ui-monospace, "SF Mono", Menlo, monospace;
    --r-sm: 6px; --r-md: 8px; --r-lg: 10px;
    color-scheme: light;
  }
  :root[data-theme="dark"] {
      --bg: #121210; --surface: #181816; --ink: #efefea; --muted: #aaa9a1; --line: #32332d; --line-strong: #62645a; --hover: #272822;
      --accent: #a5cbd0; --accent-ink: #121210; --accent-soft: #203234; --omr: #c7bdd4; --omr-soft: #302a38; --action: #efefea; --action-ink: #171816;
      --ok: #5fd3a4; --ok-soft: #123326; --no: #ff8a80; --no-soft: #3a1c1a;
      --gs1: #5fd1bf; --gs1-bg: #12302b; --gs2: #b9a2ff; --gs2-bg: #2a2150; --gs3: #f0b764; --gs3-bg: #33260f; --hl: #4a4113; color-scheme: dark;
  }
  *, *::before, *::after { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--f-body); font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  img { max-width: 100%; }
  a { color: var(--accent); text-underline-offset: 2px; }
  .wrap { max-width: 1040px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
  .skip { position: absolute; left: -999px; } .skip:focus { left: 16px; top: 8px; background: var(--surface); padding: 8px; z-index: 30; }

  /* Shared workspace: sidebar, toolbar and mobile navigation. */
  .workspace-sidebar { position: fixed; inset: 0 auto 0 0; width: 232px; padding: 28px 16px 18px; border-right: 1px solid var(--line); background: var(--bg); display: flex; flex-direction: column; overflow-y: auto; z-index: 21; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 750; font-size: 1.12rem; text-decoration: none; margin: 0 10px 38px; }
  .brand-symbol { display: grid; place-items: center; height: 28px; width: 28px; border: 1px solid var(--line-strong); border-radius: 6px; font-size: .9rem; }
  .sidebar-foot { margin-top: auto; padding: 20px 12px 0; border-top: 1px solid var(--line); display: grid; gap: 8px; font-size: .82rem; }
  .sidebar-foot a { color: var(--ink); text-decoration: none; min-height: 44px; display: flex; align-items: center; }
  .sidebar-foot span { color: var(--muted); font-size: .75rem; }
  .top, main.wrap, .foot { margin-left: 232px; }
  .top { background: var(--bg); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }
  .topin { display: flex; align-items: center; gap: 12px; min-height: 72px; padding: 10px 32px; }
  .toolbar-section { font-weight: 600; font-size: .94rem; }
  .toolbar-home, .mobile-menu { display: none !important; }
  .searchbtn { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--muted); text-decoration: none; font-size: .84rem; border: 1px solid var(--line); border-radius: 6px; padding: 6px 12px; }
  .searchbtn:hover { color: var(--ink); border-color: var(--line-strong); }
  .icon-button { display: inline-grid; place-items: center; width: 44px; height: 44px; flex: none; border: 1px solid var(--line); border-radius: 6px; background: transparent; color: var(--ink); cursor: pointer; font: inherit; font-size: 1.5rem; }
  .icon-button:hover { background: var(--hover); }
  .searchbtn svg, .icon-button svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .theme-sun { display: none; }
  :root[data-theme="dark"] .theme-sun { display: block; }
  :root[data-theme="dark"] .theme-moon { display: none; }
  .tabbar, .workspace-no-script { display: none; }
  .workspace-menu { background: var(--bg); color: var(--ink); border: 0; border-right: 1px solid var(--line); padding: 20px 16px; margin: 0; height: 100dvh; max-height: 100dvh; width: min(320px, 100%); max-width: 100%; overflow-y: auto; }
  .workspace-menu::backdrop { background: #0006; }
  .menu-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 28px; }
  .menu-heading h2 { font-size: 1.1rem; margin: 0; }
  .menu-about { display: inline-flex; min-height: 44px; align-items: center; margin-left: 12px; color: var(--muted); }
  html:has(.workspace-menu[open]) { overflow: hidden; }
  main.wrap { max-width: 1232px; padding-inline: 40px; min-height: 65vh; }
  .foot .wrap { max-width: 1232px; padding-inline: 40px; }
  .skip:focus { z-index: 50; }
  @media (max-width: 1000px) and (min-width: 761px) {
    .workspace-sidebar { width: 208px; padding-inline: 12px; }
    .top, main.wrap, .foot { margin-left: 208px; }
    main.wrap, .foot .wrap { padding-inline: 24px; }
    .topin { padding-inline: 24px; }
  }
  @media (max-width: 760px) {
    .workspace-sidebar { display: none; }
    .workspace-no-script { display: block; padding: 20px 16px 0; }
    .top, main.wrap, .foot { margin-left: 0; }
    .topin { min-height: 64px; padding: 8px 16px; gap: 8px; }
    .mobile-menu { display: inline-grid !important; }
    .toolbar-home { display: block !important; color: var(--ink); text-decoration: none; font-size: .94rem; font-weight: 700; }
    .toolbar-section { display: none; }
    .searchbtn { padding: 10px; min-height: 44px; } .searchbtn span { display: none; }
    .tabbar { display: grid; grid-template-columns: repeat(4, 1fr); position: fixed; inset: auto 0 0; z-index: 20; background: var(--bg); border-top: 1px solid var(--line); padding: 4px 8px calc(4px + env(safe-area-inset-bottom, 0px)); }
    .tabbar a, .tabbar button { font: inherit; font-size: .78rem; font-weight: 600; min-height: 48px; display: flex; align-items: center; justify-content: center; gap: 6px; background: transparent; color: var(--muted); border: 0; text-decoration: none; cursor: pointer; }
    .tabbar [aria-current] { color: var(--ink); box-shadow: inset 0 -2px var(--accent); }
    body { padding-bottom: calc(64px + env(safe-area-inset-bottom, 0px)); }
    body.focus-mode { padding-bottom: 0; }
    .focus-mode .tabbar { display: none; }
    main.wrap, .foot .wrap { padding-inline: max(16px, env(safe-area-inset-left, 0px)); }
  }

  /* Type */
  main.wrap { padding-block: 28px 64px; }
  .crumbs { font-size: .86rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .crumbs a { color: var(--muted); }
  h1 { font-weight: 800; font-size: clamp(1.75rem, 4.2vw, 2.6rem); line-height: 1.12; letter-spacing: -.025em; margin: 4px 0 12px; text-wrap: balance; max-width: 26ch; }
  h2 { font-weight: 800; font-size: 1.35rem; line-height: 1.25; letter-spacing: -.015em; margin: 36px 0 12px; text-wrap: balance; }
  h3 { font-weight: 700; font-size: 1.05rem; margin: 22px 0 6px; }
  .lead { color: var(--muted); max-width: 64ch; margin: 0 0 14px; font-size: 1.05rem; }
  .eyebrow { font-size: .88rem; color: var(--muted); font-weight: 600; margin: 0; }
  .small { font-size: .88rem; color: var(--muted); }

  /* Paper codes and badges */
  .pc { font-size: .78rem; font-weight: 700; border-radius: 999px; padding: 2px 9px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pc.gs1 { background: var(--gs1-bg); color: var(--gs1); } .pc.gs2 { background: var(--gs2-bg); color: var(--gs2); } .pc.gs3 { background: var(--gs3-bg); color: var(--gs3); }
  .xp { font-size: .78rem; font-weight: 700; color: var(--omr); background: var(--omr-soft); border-radius: 999px; padding: 2px 9px; white-space: nowrap; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px 28px; margin: 14px 0; }
  .facts div { display: flex; flex-direction: column; } .facts b { font-size: 1.4rem; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1.2; } .facts span { color: var(--muted); font-size: .86rem; }

  /* Theme cards */
  .tlist { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); }
  .tcard { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); padding: 14px 16px; display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; }
  .tcard:hover { border-color: var(--accent); }
  .tcard .tn { font-weight: 800; font-size: .85rem; color: var(--accent); padding-top: 2px; font-variant-numeric: tabular-nums; }
  .tcard a.tt { font-weight: 700; color: var(--ink); text-decoration: none; min-width: 0; line-height: 1.35; }
  .tcard a.tt::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .tcard .meta { grid-column: 2; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: .84rem; color: var(--muted); font-variant-numeric: tabular-nums; }

  /* Tables */
  .tablewrap { overflow-x: auto; } table { border-collapse: collapse; width: 100%; font-size: .94rem; }
  th, td { text-align: left; padding: 8px 9px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: .84rem; color: var(--muted); font-weight: 700; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }

  /* Chips, panels, buttons */
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-size: .9rem; font-weight: 600; color: var(--accent); background: var(--surface); border: 1px solid var(--line); text-decoration: none; padding: 5px 12px; border-radius: 999px; }
  .chip:hover { border-color: var(--accent); background: var(--accent-soft); }
  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); padding: 16px 18px; }
  .btn { font: inherit; font-size: .92rem; font-weight: 700; min-height: 44px; padding: 8px 16px; border-radius: var(--r-sm); border: 1.5px solid var(--line-strong);
    background: var(--surface); color: var(--ink); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .btn.primary, .bigbtn { background: var(--action); border-color: var(--action); color: var(--action-ink); }
  .btn.primary:hover, .bigbtn:hover { filter: brightness(1.08); color: var(--action-ink); }
  .btn:disabled { opacity: .45; cursor: default; }
  a.btn { text-decoration: none; }

  /* Questions */
  .qs { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); }
  .q { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); padding: 14px 18px; }
  .q p { margin: 6px 0; max-width: 72ch; }
  .qlink { color: inherit; text-decoration: none; } .qlink:hover { color: var(--accent); text-decoration: underline; }
  .qm { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: .85rem; color: var(--muted); }

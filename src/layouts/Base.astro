---
import { u, issueUrl } from '../lib/data';
interface Props {
  title: string;            // page-specific part of the <title>
  description: string;
  jsonld?: object[];
  noindex?: boolean;
  brand?: boolean;          // append ' | UPSC Themes' to the <title>
  crumbs?: { name: string; href: string }[];
}
const { title, description, jsonld = [], noindex = false, crumbs = [], brand = true } = Astro.props;
const SITE_NAME = 'UPSC Themes';
const fullTitle = !brand ? title : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(u('/og.png'), Astro.site).href;
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC || 'https://cloud.umami.is/script.js';
const gscToken = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const crumbLd = crumbs.length
  ? [{
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: u('/') }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, Astro.site).href })),
    }]
  : [];
const ld = [...crumbLd, ...jsonld];
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  {gscToken && <meta name="google-site-verification" content={gscToken} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="en_IN" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#2b3f8f" />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={u('/sitemap-index.xml')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:wght@500;600&family=Source+Sans+3:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  {umamiId && <script defer src={umamiSrc} data-website-id={umamiId} data-do-not-track="true"></script>}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="wrap topin">
      <a class="brand" href={u('/')}>UPSC <span>Themes</span></a>
      <nav aria-label="Main">
        <a href={u('/themes/')}>Themes</a>
        <a href={u('/papers/gs1/')}>Papers</a>
        <a href={u('/syllabus/')}>Syllabus</a>
        <a href={u('/search/')}>Search</a>
        <a href={u('/about/')}>About</a>
      </nav>
    </div>
  </header>
  <main id="main" class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={u('/')}>Home</a>
        {crumbs.map((c, i) => <>
          <span aria-hidden="true">/</span>
          {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}
        </>)}
      </nav>
    )}
    <slot />
  </main>
  <footer class="foot">
    <div class="wrap">
      <p>Free and non-commercial. Questions are from the Civil Services (Main) papers published by the <a href="https://www.upsc.gov.in/examinations/previous-question-papers" rel="noopener" data-umami-event="outbound-upsc">Union Public Service Commission</a>. Theme analysis and prep notes are this site's own.</p>
      <p><a href={u('/about/')}>About & sources</a>{issueUrl() && <> · <a href={issueUrl()} rel="noopener" data-umami-event="report-error" data-umami-event-where="footer">Report an error</a></>}</p>
    </div>
  </footer>
  <script is:inline>
    // Tracked actions that need script (copy, share). Umami's `umami` global is absent until it loads or if blocked.
    (function () {
      function track(name, data) { try { if (window.umami) window.umami.track(name, data); } catch (e) {} }
      document.addEventListener('click', function (e) {
        var b = e.target.closest('[data-copy]');
        if (b) {
          var text = b.getAttribute('data-copy');
          var done = function () { var t = b.textContent; b.textContent = 'Copied'; setTimeout(function () { b.textContent = t; }, 1500); };
          if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, function () {});
          track('copy-question', { id: b.getAttribute('data-qid') });
        }
        var s = e.target.closest('[data-share]');
        if (s) {
          var url = location.href, title = document.title;
          if (navigator.share) { navigator.share({ title: title, url: url }).catch(function () {}); }
          else if (navigator.clipboard) { navigator.clipboard.writeText(url).then(function () { var t = s.textContent; s.textContent = 'Link copied'; setTimeout(function () { s.textContent = t; }, 1500); }, function () {}); }
          track('share', { page: location.pathname });
        }
      });
      window.__track = track;
    })();
  </script>
</body>
</html>

<style is:global>
  /* Layout: one reading column; exam-paper colour codes GS1 teal / GS2 indigo / GS3 ochre */
  :root {
    --bg: #f6f7f4; --surface: #ffffff; --ink: #1d2333; --muted: #5a6274; --line: #dfe2da; --accent: #2b3f8f; --accent-soft: #e6eaf7;
    --gs1: #1f7a6d; --gs1-bg: #e1f1ee; --gs2: #3a4aa3; --gs2-bg: #e6e9f8; --gs3: #8a6a12; --gs3-bg: #f5eed9; --hl: #fff2b3;
    --f-display: "Spectral", Georgia, serif; --f-body: "Source Sans 3", "Segoe UI", system-ui, sans-serif; --f-mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12151c; --surface: #1a1f29; --ink: #e6e8ee; --muted: #9aa2b3; --line: #2b3240; --accent: #9fb0f2; --accent-soft: #232c48;
      --gs1: #6fd0c0; --gs1-bg: #16302c; --gs2: #a7b2f5; --gs2-bg: #232a4d; --gs3: #e0c06b; --gs3-bg: #352c13; --hl: #4a4113; color-scheme: dark;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--f-body); font-size: 17px; line-height: 1.6; }
  img { max-width: 100%; }
  a { color: var(--accent); }
  .wrap { max-width: 980px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
  .skip { position: absolute; left: -999px; } .skip:focus { left: 16px; top: 8px; background: var(--surface); padding: 8px; z-index: 20; }
  .top { border-bottom: 1px solid var(--line); background: var(--surface); }
  .topin { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 18px; padding-block: 12px; }
  .brand { font-family: var(--f-display); font-weight: 600; font-size: 1.2rem; color: var(--ink); text-decoration: none; }
  .brand span { color: var(--accent); }
  .top nav { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: .95rem; }
  .top nav a { color: var(--muted); text-decoration: none; font-weight: 600; } .top nav a:hover { color: var(--accent); }
  main.wrap { padding-block: 20px 56px; }
  .crumbs { font-size: .85rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
  .crumbs a { color: var(--muted); }
  h1 { font-family: var(--f-display); font-weight: 600; font-size: clamp(1.7rem, 4vw, 2.4rem); line-height: 1.2; margin: 4px 0 10px; text-wrap: balance; }
  h2 { font-family: var(--f-display); font-weight: 600; font-size: 1.4rem; line-height: 1.3; margin: 32px 0 10px; text-wrap: balance; }
  h3 { font-size: 1.05rem; margin: 22px 0 6px; }
  .lead { color: var(--muted); max-width: 68ch; margin: 0 0 12px; }
  .eyebrow { font-size: .74rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 700; margin: 0; }
  .pc { font-family: var(--f-mono); font-size: .74rem; border-radius: 4px; padding: 1px 6px; font-weight: 500; white-space: nowrap; }
  .pc.gs1 { background: var(--gs1-bg); color: var(--gs1); } .pc.gs2 { background: var(--gs2-bg); color: var(--gs2); } .pc.gs3 { background: var(--gs3-bg); color: var(--gs3); }
  .xp { font-size: .7rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--accent); border: 1px solid var(--accent); border-radius: 4px; padding: 0 5px; white-space: nowrap; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px 22px; margin: 12px 0; }
  .facts div { display: flex; flex-direction: column; } .facts b { font-size: 1.35rem; font-variant-numeric: tabular-nums; line-height: 1.2; } .facts span { color: var(--muted); font-size: .85rem; }
  .tlist { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .tcard { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; }
  .tcard:hover { border-color: var(--accent); }
  .tcard .tn { font-family: var(--f-mono); font-size: .8rem; color: var(--accent); padding-top: 3px; }
  .tcard a.tt { font-weight: 700; color: var(--ink); text-decoration: none; min-width: 0; } .tcard a.tt:hover { color: var(--accent); text-decoration: underline; }
  .tcard .meta { grid-column: 2; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: .82rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .tablewrap { overflow-x: auto; } table { border-collapse: collapse; width: 100%; font-size: .93rem; }
  th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: .74rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { font-size: .86rem; color: var(--accent); background: var(--accent-soft); text-decoration: none; padding: 3px 9px; border-radius: 5px; }
  .chip:hover { text-decoration: underline; }
  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; }
  .btn { font: inherit; font-size: .85rem; font-weight: 600; padding: 5px 10px; border-radius: 6px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .qs { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .q { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; }
  .q p { margin: 6px 0; max-width: 72ch; }
  .qm { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: .8rem; color: var(--muted); }
  .qm .yr { font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
  .qid { font-family: var(--f-mono); font-size: .74rem; word-break: break-all; }
  .qa { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 6px; }
  .qa a.small { font-size: .82rem; }
  .foot { border-top: 1px solid var(--line); color: var(--muted); font-size: .88rem; padding-block: 18px 28px; }
  .foot p { max-width: 75ch; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  mark { background: var(--hl); color: inherit; }
</style>

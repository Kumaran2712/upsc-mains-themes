---
import { u, issueUrl } from '../lib/data';
interface Props {
  title: string;            // page-specific part of the <title>
  description: string;
  jsonld?: object[];
  noindex?: boolean;
  brand?: boolean;          // append ' | UPSC Themes' to the <title>
  crumbs?: { name: string; href: string }[];
}
const { title, description, jsonld = [], noindex = false, crumbs = [], brand = true } = Astro.props;
const SITE_NAME = 'UPSC Themes';
const fullTitle = !brand ? title : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(u('/og.png'), Astro.site).href;
// Accept either the bare ID or a pasted tracking snippet: keep only the UUID.
const umamiId = (String(import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || '').match(/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i) || [])[0];
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC || 'https://cloud.umami.is/script.js';
// Search Console: one or more codes (comma-separated); each may be the bare code or a pasted <meta> tag.
const gscRaw = String(import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '');
const gscTokens = [...new Set(gscRaw.split(',').map((x) => ((x.match(/content="([^"]+)"/) || [])[1] || x).trim()).filter((x) => /^[\w-]{20,}$/.test(x)))];
const crumbLd = crumbs.length
  ? [{
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: u('/') }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, Astro.site).href })),
    }]
  : [];
const ld = [...crumbLd, ...jsonld];
// Navigation: a short top menu on wide screens, a bottom tab bar on phones.
const path = Astro.url.pathname;
const active = (href: string) => { const h = u(href); return h === u('/') ? path === h : path.startsWith(h); };
const NAV = [
  { label: 'Today', href: '/daily/' }, { label: 'Prelims', href: '/prelims/' }, { label: 'Roadmap', href: '/roadmap/' },
  { label: 'Themes', href: '/themes/' }, { label: 'Maps', href: '/maps/' },
];
const TABS = [
  { label: 'Today', href: '/daily/', icon: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3.5" class="fill"/>' },
  { label: 'Prelims', href: '/prelims/', icon: '<circle cx="6.5" cy="7" r="2.5"/><circle cx="6.5" cy="17" r="2.5" class="fill"/><path d="M12 7h8M12 17h8"/>' },
  { label: 'Roadmap', href: '/roadmap/', icon: '<path d="M5 19c0-6 14-4 14-10"/><circle cx="5" cy="19" r="1.8" class="fill"/><circle cx="19" cy="5" r="1.8"/>' },
  { label: 'Themes', href: '/themes/', icon: '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>' },
  { label: 'Maps', href: '/maps/', icon: '<path d="M4 6l5-2 6 2 5-2v14l-5 2-6-2-5 2z"/><path d="M9 4v14M15 6v14"/>' },
];
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  {gscTokens.map((t) => <meta name="google-site-verification" content={t} />)}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="en_IN" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#2b3f8f" />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={u('/sitemap-index.xml')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" />
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  {umamiId && <script defer src={umamiSrc} data-website-id={umamiId} data-do-not-track="true"></script>}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="wrap topin">
      <a class="brand" href={u('/')} aria-label="UPSC Themes home"><span class="mark" aria-hidden="true"><i></i><i></i><i></i></span>UPSC Themes</a>
      <nav class="mainnav" aria-label="Main">
        {NAV.map((n) => <a href={u(n.href)} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <a class="searchbtn" href={u('/search/')} aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg><span>Search</span></a>
    </div>
  </header>
  <nav class="tabbar" aria-label="Sections">
    {TABS.map((n) => <a href={u(n.href)} aria-current={active(n.href) ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={n.icon} /><span>{n.label}</span></a>)}
  </nav>
  <main id="main" class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={u('/')}>Home</a>
        {crumbs.map((c, i) => <>
          <span aria-hidden="true">/</span>
          {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}
        </>)}
      </nav>
    )}
    <slot />
  </main>
  <footer class="foot">
    <div class="wrap">
      <p>Free and non-commercial. Questions are from the Civil Services (Main) papers published by the <a href="https://www.upsc.gov.in/examinations/previous-question-papers" rel="noopener" data-umami-event="outbound-upsc">Union Public Service Commission</a>. Theme analysis and prep notes are this site's own.</p>
      <p class="footnav"><a href={u('/papers/gs1/')}>Mains papers</a><a href={u('/syllabus/')}>Syllabus</a><a href={u('/themes/')}>All themes</a><a href={u('/about/')}>About & sources</a></p>
      <p><a href={u('/about/')}>Privacy</a>{issueUrl() && <> · <a href={issueUrl()} rel="noopener" data-umami-event="report-error" data-umami-event-where="footer">Report an error</a></>}</p>
    </div>
  </footer>
  <script is:inline>
    // Tracked actions that need script (copy, share). Umami's `umami` global is absent until it loads or if blocked.
    (function () {
      function track(name, data) { try { if (window.umami) window.umami.track(name, data); } catch (e) {} }
      document.addEventListener('click', function (e) {
        var b = e.target.closest('[data-copy]');
        if (b) {
          var text = b.getAttribute('data-copy');
          var done = function () { var t = b.textContent; b.textContent = 'Copied'; setTimeout(function () { b.textContent = t; }, 1500); };
          if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, function () {});
          track('copy-question', { id: b.getAttribute('data-qid') });
        }
        var s = e.target.closest('[data-share]');
        if (s) {
          var url = location.href, title = document.title;
          if (navigator.share) { navigator.share({ title: title, url: url }).catch(function () {}); }
          else if (navigator.clipboard) { navigator.clipboard.writeText(url).then(function () { var t = s.textContent; s.textContent = 'Link copied'; setTimeout(function () { s.textContent = t; }, 1500); }, function () {}); }
          track('share', { page: location.pathname });
        }
      });
      document.addEventListener('click', function (e) {
        var z = e.target.closest('.zoombtn'); if (!z) return;
        var svg = document.getElementById(z.getAttribute('data-for')); if (!svg) return;
        var box = svg.parentElement, on = z.getAttribute('aria-pressed') !== 'true';
        z.setAttribute('aria-pressed', on ? 'true' : 'false'); box.classList.toggle('zoomed', on);
        if (on) box.scrollLeft = (box.scrollWidth - box.clientWidth) * 0.55;
      });
      window.__track = track;
    })();
  </script>
</body>
</html>

<style is:global>
  /* UPSC Themes — a study app built around the exam's own objects: the OMR answer sheet (ballpoint-blue
     ink, rose dropout-ink bubbles) and GS paper colours (GS1 teal / GS2 violet / GS3 amber). */
  :root {
    --bg: #f1f3f8; --surface: #ffffff; --ink: #141a33; --muted: #46506a; --line: #d9dfea; --line-strong: #b9c2d4;
    --accent: #2340b5; --accent-ink: #ffffff; --accent-soft: #e6ebfb; --omr: #d2457a; --omr-soft: #fbe7ef;
    --ok: #0f7a55; --ok-soft: #e1f4ec; --no: #bf3329; --no-soft: #fbe6e4;
    --gs1: #0b7666; --gs1-bg: #dff2ee; --gs2: #6236c4; --gs2-bg: #ece6fb; --gs3: #a15c00; --gs3-bg: #fbeedb; --hl: #fff1a8;
    --f-display: "Figtree", system-ui, sans-serif; --f-body: "Figtree", system-ui, sans-serif; --f-mono: ui-monospace, "SF Mono", Menlo, monospace;
    --r-sm: 8px; --r-md: 12px; --r-lg: 20px;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1324; --surface: #171c31; --ink: #eef1fa; --muted: #a9b2cb; --line: #2a3150; --line-strong: #3b4468;
      --accent: #8ea6ff; --accent-ink: #0f1324; --accent-soft: #232c55; --omr: #f07aa6; --omr-soft: #3a1f2d;
      --ok: #5fd3a4; --ok-soft: #123326; --no: #ff8a80; --no-soft: #3a1c1a;
      --gs1: #5fd1bf; --gs1-bg: #12302b; --gs2: #b9a2ff; --gs2-bg: #2a2150; --gs3: #f0b764; --gs3-bg: #33260f; --hl: #4a4113; color-scheme: dark;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--f-body); font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  img { max-width: 100%; }
  a { color: var(--accent); text-underline-offset: 2px; }
  .wrap { max-width: 1040px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
  .skip { position: absolute; left: -999px; } .skip:focus { left: 16px; top: 8px; background: var(--surface); padding: 8px; z-index: 30; }

  /* Header + navigation */
  .top { background: var(--surface); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }
  .topin { display: flex; align-items: center; gap: 12px 28px; min-height: 60px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.12rem; letter-spacing: -.01em; color: var(--ink); text-decoration: none; }
  .mark { display: inline-grid; grid-template-columns: repeat(3, 9px); gap: 3px; }
  .mark i { width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid var(--omr); }
  .mark i:nth-child(2) { background: var(--accent); border-color: var(--accent); }
  .mainnav { display: flex; gap: 4px; margin-left: 8px; }
  .mainnav a { color: var(--muted); text-decoration: none; font-weight: 600; font-size: .95rem; padding: 7px 12px; border-radius: 999px; }
  .mainnav a:hover { color: var(--ink); background: var(--bg); }
  .mainnav a[aria-current="page"] { color: var(--accent); background: var(--accent-soft); }
  .searchbtn { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; color: var(--muted); text-decoration: none; font-weight: 600; font-size: .95rem;
    border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px 6px 10px; }
  .searchbtn:hover { color: var(--ink); border-color: var(--line-strong); }
  .searchbtn svg, .tabbar svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .tabbar svg .fill { fill: currentColor; }
  .tabbar { display: none; }
  @media (max-width: 760px) {
    .mainnav { display: none; }
    .searchbtn { padding: 8px; } .searchbtn span { display: none; }
    .tabbar { display: grid; grid-template-columns: repeat(5, 1fr); position: fixed; left: 0; right: 0; bottom: 0; z-index: 25;
      background: var(--surface); border-top: 1px solid var(--line); padding: 6px 4px calc(6px + env(safe-area-inset-bottom, 0px)); }
    .tabbar a { display: grid; justify-items: center; gap: 2px; padding: 4px 0; font-size: .72rem; font-weight: 600; color: var(--muted); text-decoration: none; }
    .tabbar a[aria-current="page"] { color: var(--accent); }
    body { padding-bottom: calc(68px + env(safe-area-inset-bottom, 0px)); }
  }

  /* Type */
  main.wrap { padding-block: 22px 64px; }
  .crumbs { font-size: .86rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .crumbs a { color: var(--muted); }
  h1 { font-weight: 800; font-size: clamp(1.75rem, 4.2vw, 2.6rem); line-height: 1.12; letter-spacing: -.025em; margin: 4px 0 12px; text-wrap: balance; max-width: 26ch; }
  h2 { font-weight: 800; font-size: 1.35rem; line-height: 1.25; letter-spacing: -.015em; margin: 36px 0 12px; text-wrap: balance; }
  h3 { font-weight: 700; font-size: 1.05rem; margin: 22px 0 6px; }
  .lead { color: var(--muted); max-width: 64ch; margin: 0 0 14px; font-size: 1.05rem; }
  .eyebrow { font-size: .88rem; color: var(--muted); font-weight: 600; margin: 0; }
  .small { font-size: .88rem; color: var(--muted); }

  /* Paper codes and badges */
  .pc { font-size: .78rem; font-weight: 700; border-radius: 999px; padding: 2px 9px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pc.gs1 { background: var(--gs1-bg); color: var(--gs1); } .pc.gs2 { background: var(--gs2-bg); color: var(--gs2); } .pc.gs3 { background: var(--gs3-bg); color: var(--gs3); }
  .xp { font-size: .78rem; font-weight: 700; color: var(--omr); background: var(--omr-soft); border-radius: 999px; padding: 2px 9px; white-space: nowrap; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px 28px; margin: 14px 0; }
  .facts div { display: flex; flex-direction: column; } .facts b { font-size: 1.4rem; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1.2; } .facts span { color: var(--muted); font-size: .86rem; }

  /* Theme cards */
  .tlist { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); }
  .tcard { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); padding: 14px 16px; display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; }
  .tcard:hover { border-color: var(--accent); }
  .tcard .tn { font-weight: 800; font-size: .85rem; color: var(--accent); padding-top: 2px; font-variant-numeric: tabular-nums; }
  .tcard a.tt { font-weight: 700; color: var(--ink); text-decoration: none; min-width: 0; line-height: 1.35; }
  .tcard a.tt::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .tcard .meta { grid-column: 2; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: .84rem; color: var(--muted); font-variant-numeric: tabular-nums; }

  /* Tables */
  .tablewrap { overflow-x: auto; } table { border-collapse: collapse; width: 100%; font-size: .94rem; }
  th, td { text-align: left; padding: 8px 9px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: .84rem; color: var(--muted); font-weight: 700; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }

  /* Chips, panels, buttons */
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-size: .9rem; font-weight: 600; color: var(--accent); background: var(--surface); border: 1px solid var(--line); text-decoration: none; padding: 5px 12px; border-radius: 999px; }
  .chip:hover { border-color: var(--accent); background: var(--accent-soft); }
  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); padding: 16px 18px; }
  .btn { font: inherit; font-size: .92rem; font-weight: 700; min-height: 40px; padding: 8px 16px; border-radius: 999px; border: 1.5px solid var(--line-strong);
    background: var(--surface); color: var(--ink); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .btn.primary, .bigbtn { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .btn.primary:hover, .bigbtn:hover { filter: brightness(1.08); color: var(--accent-ink); }
  .btn:disabled { opacity: .45; cursor: default; }
  a.btn { text-decoration: none; }

  /* Questions */
  .qs { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); }
  .q { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); padding: 14px 18px; }
  .q p { margin: 6px 0; max-width: 72ch; }
  .qlink { color: inherit; text-decoration: none; } .qlink:hover { color: var(--accent); text-decoration: underline; }
  .qm { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: .85rem; color: var(--muted); }
  .qm .yr { font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
  .qid { font-family: var(--f-mono); font-size: .74rem; word-break: break-all; }
  .qa { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 8px; }
  .qa a.small { font-size: .85rem; }

  /* Prelims question blocks (browse pages) */
  .pre .st { list-style: none; padding: 0 0 0 4px; margin: 4px 0; display: grid; gap: 4px; }
  .pt { font-size: .92rem; margin: 6px 0; border-collapse: collapse; } .pt td { border: 1px solid var(--line); padding: 5px 9px; vertical-align: top; } .pt.hd tr:first-child td { font-weight: 700; background: var(--bg); }
  .po { list-style: none; padding: 0; margin: 10px 0; display: grid; gap: 6px; }
  .po li { display: flex; gap: 10px; align-items: baseline; }
  .po li b { flex: none; display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid var(--omr); color: var(--omr); font-size: .8rem; }
  .pre details { margin-top: 8px; } .pre summary { cursor: pointer; color: var(--accent); font-weight: 700; font-size: .95rem; }
  .subh { list-style: none; } .subh h2 { margin: 18px 0 0; }

  .foot { border-top: 1px solid var(--line); background: var(--surface); color: var(--muted); font-size: .9rem; padding-block: 22px 30px; }
  .foot p { max-width: 75ch; }
  .footnav { display: flex; flex-wrap: wrap; gap: 6px 18px; font-weight: 600; }
  :focus-visible { outline: 2.5px solid var(--accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; transition: none !important; } }
</style>

# Public address of the site (canonical URLs + sitemap)
SITE_URL=https://kumaran2712.github.io
# Only for a GitHub Pages project site; leave empty on a custom domain
BASE_PATH=/upsc-mains-themes
# This site's own GitHub repo, for 'Report a typo' links (leave empty to hide them)
PUBLIC_REPO_URL=https://github.com/Kumaran2712/upsc-mains-themes
# Umami Cloud → Settings → Websites → your site → Website ID
PUBLIC_UMAMI_WEBSITE_ID=
# Google Search Console → HTML tag method → the content="…" value
PUBLIC_GOOGLE_SITE_VERIFICATION=
